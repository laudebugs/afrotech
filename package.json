{
  "name": "afrotech26",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && tsc -p worker && astro build",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "preview": "npm run build && npm run db:migrate:local && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply afrotech --local",
    "db:migrate:remote": "wrangler d1 migrations apply afrotech --remote",
    "deploy": "npm run build && wrangler d1 migrations apply afrotech --remote && wrangler deploy",
    "astro": "astro",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts && python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^22.20.5",
    "astro": "^7.4.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@panzoom/panzoom": "^4.6.2",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "jose": "6.2.12",
    "maplibre-gl": "^6.16.0",
    "markdown-it": "14.1.0"
  }
}
