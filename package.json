{
  "name": "afrotech26",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && tsc -p worker && astro build",
    "preview": "npm run build && npm run db:migrate:local && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply afrotech --local",
    "db:migrate:remote": "wrangler d1 migrations apply afrotech --remote",
    "deploy": "npm run build && wrangler deploy",
    "astro": "astro"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "^22.20.5",
    "astro": "^7.4.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@panzoom/panzoom": "^4.6.2",
    "maplibre-gl": "^6.16.0"
  }
}
