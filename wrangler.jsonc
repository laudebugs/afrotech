{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "afrotech2026",
  "compatibility_date": "2026-11-01",
  // A small Worker answers /api/* (sign-in and plan sync, plan 0002); every
  // other request is a static file from dist/, served without running it.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Public by design: the browser needs it to show Google's sign-in button.
  "vars": {
    "GOOGLE_CLIENT_ID": "316564590500-t9tgifb1fhjool4mhfi6dp93pbug1n0j.apps.googleusercontent.com",
    // The admin dashboard's traffic (plan 0011) reads Cloudflare's analytics for
    // this host in this zone. The token (CF_ANALYTICS_TOKEN) and the admin list
    // (ADMIN_EMAILS) are secrets, set in the Cloudflare dashboard.
    "ANALYTICS_ZONE": "laudebugs.me",
    "ANALYTICS_HOST": "afrotech26.laudebugs.me"
  },
  // At most 10 sign-in attempts per minute from one address.
  "ratelimits": [
    { "name": "SIGNIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afrotech",
      "database_id": "45965e56-ece8-462d-b699-164835ebeca3",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Note photos (plan 0006): private, read and written only through /api/photos.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "afrotech-note-photos" }],
  // Keep the workers.dev address and branch preview URLs on; setting routes
  // would otherwise switch both off.
  "workers_dev": true,
  "preview_urls": true,
  // Branch builds run `wrangler preview`, which needs this block (it can be empty).
  "previews": {},
  "routes": [
    { "pattern": "afrotech26.laudebugs.me", "custom_domain": true }
  ]
}
