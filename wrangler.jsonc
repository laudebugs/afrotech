{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "afrotech26",
  "compatibility_date": "2026-11-01",
  // Static site: no Worker script, Cloudflare serves the built files directly.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "afrotech26.laudebugs.me", "custom_domain": true }
  ]
}
