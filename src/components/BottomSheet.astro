---
// Slides up from the bottom on phones; a centred dialog on wider screens.
// Open it with sheet.showModal(); Escape, the close button and a backdrop tap close it.
import Icon from "./Icon.astro";

interface Props {
  id: string;
  label: string;
}
const { id, label } = Astro.props;
---

<dialog class="sheet" id={id} aria-label={label}>
  <form method="dialog" class="close-row">
    <button class="close" aria-label="Close"><Icon name="close" size={20} /></button>
  </form>
  <div class="content"><slot /></div>
</dialog>

<script>
  // A tap on the backdrop (outside the sheet) closes it.
  document.querySelectorAll<HTMLDialogElement>("dialog.sheet").forEach((sheet) => {
    sheet.addEventListener("click", (e) => {
      if (e.target === sheet) sheet.close();
    });
  });
</script>

<style>
  .sheet {
    width: 100%;
    max-width: 100%;
    max-height: 85vh;
    margin: auto 0 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow);
  }
  .sheet[open] {
    animation: rise var(--ease);
  }
  .sheet::backdrop {
    background: var(--backdrop);
  }
  .close-row {
    position: sticky;
    top: 0;
    display: flex;
    justify-content: flex-end;
    padding: var(--space-2);
    background: var(--surface);
  }
  .close {
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    cursor: pointer;
  }
  .content {
    padding: 0 var(--space-4) calc(var(--space-6) + env(safe-area-inset-bottom));
  }
  @keyframes rise {
    from {
      transform: translateY(24px);
      opacity: 0;
    }
  }
  @media (min-width: 768px) {
    .sheet {
      max-width: 560px;
      margin: auto;
      border-radius: var(--radius-md);
    }
  }
</style>
