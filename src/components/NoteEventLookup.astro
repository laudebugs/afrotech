---
// Session titles and times for the notes pages, which read notes in the
// browser and need to name the session each note is about.
// The editor also asks for each session's speakers, for its Insert menu.
import { allEvents } from "../lib/events";
import { speakerBySlug } from "../lib/speakers";
import { formatDate, formatRange } from "../lib/time";

interface Props {
  withSpeakers?: boolean;
}
const { withSpeakers = false } = Astro.props;

const lookup = Object.fromEntries(
  allEvents.map((e) => [
    e.id,
    {
      title: e.title,
      when: e.start ? `${formatDate(e.start)}, ${formatRange(e.start, e.end)}` : `${e.date} (time TBA)`,
      place: e.locationLabel,
      ...(withSpeakers && e.speakers.length
        ? {
            speakers: e.speakers.map((s) => ({
              name: s.name,
              // Linked only when the profile page exists, as on event pages.
              slug: speakerBySlug(s.slug) ? s.slug : null,
              role: [s.title, s.company].filter(Boolean).join(", "),
            })),
          }
        : {}),
    },
  ]),
);
---

<script is:inline type="application/json" id="note-events" set:html={JSON.stringify(lookup).replace(/</g, "\\u003c")} />
