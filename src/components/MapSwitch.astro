---
// Switches between the convention center map and the city map of side events.
import PageTabs from "./PageTabs.astro";

interface Props {
  current: "venue" | "city";
}
const { current } = Astro.props;
---

<PageTabs
  label="Map"
  tabs={[
    { href: "/map/", label: "Convention center", current: current === "venue" },
    { href: "/map/city/", label: "City", current: current === "city" },
  ]}
/>
