---
// The vertical rail every day view hangs on. Children are TimelineRow,
// NowMarker and TimeHeader.
interface Props {
  label?: string;
}
const { label } = Astro.props;
---

<div class="timeline" data-label={label}>
  <slot />
</div>

<style>
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-2) 0;
  }
  .timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--rail-time) + var(--rail-dot) / 2 - 1px);
    width: 2px;
    background: var(--line);
  }
</style>
