---
// An event hanging off the timeline: title, place and time, star, and when
// relevant a progress bar (live events) and a clash warning (My plan).
import Star from "./Star.astro";
import type { ScheduleEvent } from "../lib/types";
import { formatTime } from "../lib/time";

interface Props {
  event: ScheduleEvent;
  inPlan?: boolean;
  /** 0–100 when live. */
  progress?: number | null;
  /** e.g. "Clashes with 11:05 Building Products…" */
  clash?: string | null;
}
const { event, inPlan = false, progress = null, clash = null } = Astro.props;

const place = event.locationLabel;
const until = event.end ? `until ${formatTime(event.end)}` : null;
const meta = [place, until].filter(Boolean).join(" · ");
const people =
  event.kind === "official"
    ? event.speakers.map((s) => s.name).slice(0, 2).join(", ")
    : event.host;
---

<article class="card" data-event-id={event.id} data-in-plan={inPlan ? "true" : undefined}>
  <div class="text">
    <h3 class="title"><a href={`/event/${event.id}/`}>{event.title}</a></h3>
    <p class="meta">{meta}</p>
    {people && <p class="meta people">{people}</p>}
    {
      progress !== null && (
        <div
          class="progress"
          role="progressbar"
          aria-label="Session progress"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow={Math.round(progress)}
        >
          <span style={`width: ${Math.max(2, Math.min(100, progress))}%`} />
        </div>
      )
    }
    {clash && <p class="clash">{clash}</p>}
  </div>
  <Star eventId={event.id} title={event.title} on={inPlan} />
</article>

<style>
  .card {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .card[data-in-plan="true"] {
    border-color: var(--accent);
  }
  .text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .title {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .title a {
    color: var(--ink);
    text-decoration: none;
  }
  .title a:hover {
    text-decoration: underline;
  }
  .meta {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }
  .progress {
    height: 4px;
    margin-top: var(--space-1);
    border-radius: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .progress span {
    display: block;
    height: 100%;
    border-radius: 2px;
    background: var(--live);
  }
  .clash {
    margin: 0;
    color: var(--warn);
    font-size: var(--text-xs);
    font-weight: 600;
  }
</style>
