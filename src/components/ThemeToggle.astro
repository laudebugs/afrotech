---
// Cycles the theme: device setting → light → dark. Saved per device.
import Icon from "./Icon.astro";
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Theme: match device">
  <Icon name="theme" size={20} />
</button>

<script>
  import { readPrefs, writePrefs, type ThemePref } from "../lib/prefs";

  const order: ThemePref[] = ["system", "light", "dark"];
  const labels: Record<ThemePref, string> = {
    system: "Theme: match device",
    light: "Theme: light",
    dark: "Theme: dark",
  };

  // The browser toolbar colour follows a manual choice too.
  const metas = [...document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')];
  metas.forEach((m) => (m.dataset.media = m.media));

  function apply(theme: ThemePref) {
    if (theme === "system") delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = theme;
    const bg = getComputedStyle(document.documentElement).getPropertyValue("--bg").trim();
    metas.forEach((m) => {
      m.media = theme === "system" ? (m.dataset.media ?? "") : "all";
      if (theme !== "system" && bg) m.content = bg;
    });
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((b) => {
      b.setAttribute("aria-label", labels[theme]);
    });
  }

  apply(readPrefs().theme);
  document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const current = readPrefs().theme;
      const next = order[(order.indexOf(current) + 1) % order.length];
      writePrefs({ theme: next });
      apply(next);
    });
  });
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
</style>
