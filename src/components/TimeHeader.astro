---
// Sticky hour heading ("9 AM") on long day views.
interface Props {
  label: string;
  id?: string;
}
const { label, id } = Astro.props;
---

<h2 class="time-header" id={id}>{label}</h2>

<style>
  .time-header {
    position: sticky;
    top: 0;
    z-index: 5;
    margin: var(--space-2) 0 0;
    padding: var(--space-2) 0 var(--space-2) calc(var(--rail-time) + var(--rail-dot) + var(--space-2));
    background: var(--bg);
    font-size: var(--text-sm);
    color: var(--muted);
  }
</style>
