---
// The four main sections. A bottom tab bar on phones, a left rail from 1024 px.
import Icon from "./Icon.astro";

export type Section = "now" | "schedule" | "map" | "plan" | "none";
interface Props {
  active: Section;
}
const { active } = Astro.props;

// Now and Saved (My plan) render every event (~750 KB), so they prefetch on tap like
// other links; the small tabs prefetch as soon as they're visible.
const items = [
  { id: "now", href: "/", label: "Now", icon: "now", prefetch: "tap" },
  { id: "schedule", href: "/schedule/", label: "Schedule", icon: "schedule", prefetch: "viewport" },
  { id: "map", href: "/map/", label: "Map", icon: "map", prefetch: "viewport" },
  { id: "plan", href: "/plan/", label: "Saved", icon: "star", prefetch: "tap" },
] as const;
---

<nav class="app-nav" aria-label="Main">
  {
    items.map((item) => (
      <a href={item.href} aria-current={active === item.id ? "page" : undefined} data-astro-prefetch={item.prefetch}>
        <Icon name={item.icon} />
        <span>
          {item.label}
          {item.id === "plan" && <span class="count" data-plan-count hidden />}
        </span>
      </a>
    ))
  }
</nav>

<style>
  .app-nav {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 20;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    height: calc(var(--tabbar-height) + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: var(--tap);
    color: var(--muted);
    font-size: var(--text-xs);
    text-decoration: none;
  }
  a[aria-current="page"] {
    color: var(--accent);
    font-weight: 600;
  }
  .count:not([hidden])::before {
    content: " · ";
  }

  @media (min-width: 1024px) {
    .app-nav {
      inset: 0 auto 0 0;
      width: 88px;
      height: auto;
      grid-template-columns: 1fr;
      grid-auto-rows: 72px;
      align-content: start;
      padding: var(--space-6) 0 0;
      border-top: 0;
      border-right: 1px solid var(--line);
    }
  }
</style>
