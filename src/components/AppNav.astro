---
// The four main sections. On phones, a floating Liquid Glass tab bar (plan
// 0010): a see-through pill with a capsule behind the current tab. Between
// pages the bar stays put (the view transition "tab-bar") and the capsule
// glides to the new tab. The glide is handed from the old page to the new one
// (BaseLayout's head script), so it's one smooth motion even when the browser
// skips the page transition. From 1024 px it's a left rail.
import Icon from "./Icon.astro";
import { scheduleDays } from "../lib/schedule";

export type Section = "now" | "schedule" | "map" | "plan" | "none";
interface Props {
  active: Section;
}
const { active } = Astro.props;

// Now and Saved (My plan) render every event (~750 KB), so they prefetch on tap like
// other links; the small tabs prefetch as soon as they're visible.
const items = [
  { id: "now", href: "/", label: "Now", icon: "now", prefetch: "tap" },
  // Schedule opens today's full day page during the week (schedule-links.ts),
  // so it prefetches on tap like the other big pages.
  { id: "schedule", href: "/schedule/", label: "Schedule", icon: "schedule", prefetch: "tap" },
  { id: "map", href: "/map/", label: "Map", icon: "map", prefetch: "viewport" },
  { id: "plan", href: "/plan/", label: "Saved", icon: "star", prefetch: "tap" },
] as const;
---

<nav class="app-nav" aria-label="Main" data-schedule-days={JSON.stringify(scheduleDays)}>
  {
    items.map((item) => (
      <a href={item.href} aria-current={active === item.id ? "page" : undefined} data-astro-prefetch={item.prefetch}>
        {active === item.id && <span class="capsule" aria-hidden="true" />}
        <span class="item">
          <span class="icon"><Icon name={item.icon} /></span>
          <span>
            {item.label}
            {item.id === "plan" && <span class="count" data-plan-count hidden />}
          </span>
        </span>
      </a>
    ))
  }
</nav>

<script>
  // Instant response (plan 0010): the moment a finger or mouse goes down on a
  // tab, the capsule glides to it and the tab lights up, while the page loads
  // behind. A press that doesn't become a tap on a tab (a drag, a long-press
  // for the link menu, a release over another tab) puts it back.
  const nav = document.querySelector<HTMLElement>(".app-nav");
  const capsule = nav?.querySelector<HTMLElement>(".capsule");
  let undo: (() => void) | null = null;
  let settle = 0;

  function pressTab(link: HTMLAnchorElement) {
    undo?.(); // a second press starts from the real current tab
    if (!nav || !capsule || link.getAttribute("aria-current") === "page") return;
    const current = nav.querySelector<HTMLAnchorElement>('a[aria-current="page"]');
    const home = capsule.parentElement!.getBoundingClientRect();
    // Still gliding in from the last page: hold it where it is, and go on from there.
    const glides = capsule.getAnimations().filter((a) => !(a instanceof CSSTransition));
    if (glides.length) {
      const now = capsule.getBoundingClientRect();
      glides.forEach((a) => a.cancel());
      capsule.style.transition = "none";
      capsule.style.transform = `translate(${now.left - home.left}px, ${now.top - home.top}px)`;
      capsule.getBoundingClientRect();
      capsule.style.transition = "";
    }
    const to = link.getBoundingClientRect();
    capsule.style.transform = `translate(${to.left - home.left}px, ${to.top - home.top}px)`;
    nav.dataset.pressing = "";
    link.dataset.pressed = "";
    current?.setAttribute("data-leaving", "");
    undo = () => {
      clearTimeout(settle);
      capsule.style.transform = "";
      delete nav.dataset.pressing;
      delete link.dataset.pressed;
      current?.removeAttribute("data-leaving");
      undo = null;
    };
  }

  nav?.addEventListener("pointerdown", (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>("a");
    if (!link || e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
    pressTab(link);
  });
  // Unless a click on the pressed tab follows the release, nothing is opening:
  // put the bar back.
  nav?.addEventListener("pointerup", () => {
    clearTimeout(settle);
    settle = window.setTimeout(() => undo?.(), 500);
  });
  nav?.addEventListener("click", (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>("a[data-pressed]");
    if (link && !e.defaultPrevented) clearTimeout(settle);
    else undo?.();
  });
  nav?.addEventListener("pointercancel", () => undo?.());
  nav?.addEventListener("contextmenu", () => undo?.());
  nav?.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && undo?.());
  // Back to a page kept in memory: show it as it was.
  window.addEventListener("pageshow", (e) => e.persisted && undo?.());

</script>

<style>
  .app-nav {
    position: fixed;
    left: var(--tabbar-gap);
    right: var(--tabbar-gap);
    bottom: calc(env(safe-area-inset-bottom) + var(--tabbar-gap));
    z-index: 20;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    height: var(--tabbar-height);
    padding: var(--space-1);
    border-radius: var(--radius-pill);
    /* Glass: the page shows through, blurred and a little richer. */
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow:
      var(--glass-shadow),
      inset 0 1px 0 var(--glass-highlight),
      inset 0 0 0 1px var(--glass-edge);
    view-transition-name: tab-bar;
  }
  a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    border-radius: var(--radius-pill);
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 500;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    /* No double-tap zoom wait on the tabs. */
    touch-action: manipulation;
  }
  a[aria-current="page"],
  a[data-pressed] {
    color: var(--accent);
    font-weight: 600;
  }
  a[aria-current="page"][data-leaving] {
    color: var(--ink);
    font-weight: 500;
  }
  /* The lens behind the current tab. */
  .capsule {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--glass-capsule);
    box-shadow: inset 0 1px 0 var(--glass-highlight);
  }
  .item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .icon {
    display: inline-grid;
  }
  .count:not([hidden])::before {
    content: " · ";
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Pressing a tab squeezes it a little; letting go springs it back. */
    .icon {
      transition: transform 380ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    /* The capsule glides without overshoot, so its move across two pages
       reads as one motion rather than a wobble. */
    .capsule {
      transition: transform 340ms cubic-bezier(0.32, 0.72, 0, 1);
    }
    a:active .icon {
      transform: scale(0.86);
      transition-duration: 90ms;
    }
    .app-nav:not([data-pressing]) a[aria-current="page"]:active .capsule {
      transform: scale(1.06);
      transition-duration: 120ms;
    }
  }

  /* While you type on a touch screen (src/scripts/typing.ts), the bar slides
     down out of the way, leaving room for the keyboard and the editor's
     toolbar. */
  @media (pointer: coarse) and (max-width: 1023px) {
    :global(html[data-typing]) .app-nav {
      transform: translateY(calc(100% + var(--tabbar-gap) + env(safe-area-inset-bottom)));
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
    }
  }
  @media (pointer: coarse) and (max-width: 1023px) and (prefers-reduced-motion: no-preference) {
    .app-nav {
      transition:
        transform 280ms cubic-bezier(0.32, 0.72, 0, 1),
        opacity 200ms ease-out,
        visibility 280ms;
    }
  }

  /* Without see-through effects (or when they're turned off), a solid bar. */
  @media (prefers-reduced-transparency: reduce) {
    .app-nav {
      background: var(--surface);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .app-nav {
      background: var(--surface);
    }
  }
  @media (forced-colors: active) {
    .app-nav {
      border: 1px solid CanvasText;
    }
    .capsule {
      border: 1px solid Highlight;
    }
  }

  @media (min-width: 1024px) {
    .app-nav {
      inset: 0 auto 0 0;
      width: 88px;
      height: auto;
      grid-template-columns: 1fr;
      grid-auto-rows: 72px;
      align-content: start;
      gap: var(--space-1);
      padding: var(--space-6) var(--space-2) 0;
      border-radius: 0;
      box-shadow: none;
      /* The rail stays solid; glass is for the floating phone bar. */
      background: var(--surface);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      border-right: 1px solid var(--line);
    }
    a {
      border-radius: var(--radius-md);
    }
  }
</style>
