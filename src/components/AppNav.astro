---
// The four main sections. On phones, a floating Liquid Glass tab bar (plan
// 0010): a see-through pill with a capsule behind the current tab. Between
// pages the capsule glides to the new tab (a view transition named
// "tab-capsule") while the bar itself stays put ("tab-bar"). From 1024 px it's
// a left rail.
import Icon from "./Icon.astro";
import { scheduleDays } from "../lib/schedule";

export type Section = "now" | "schedule" | "map" | "plan" | "none";
interface Props {
  active: Section;
}
const { active } = Astro.props;

// Now and Saved (My plan) render every event (~750 KB), so they prefetch on tap like
// other links; the small tabs prefetch as soon as they're visible.
const items = [
  { id: "now", href: "/", label: "Now", icon: "now", prefetch: "tap" },
  { id: "schedule", href: "/schedule/", label: "Schedule", icon: "schedule", prefetch: "viewport" },
  { id: "map", href: "/map/", label: "Map", icon: "map", prefetch: "viewport" },
  { id: "plan", href: "/plan/", label: "Saved", icon: "star", prefetch: "tap" },
] as const;
---

<nav class="app-nav" aria-label="Main" data-days={JSON.stringify(scheduleDays)}>
  {
    items.map((item) => (
      <a href={item.href} aria-current={active === item.id ? "page" : undefined} data-astro-prefetch={item.prefetch}>
        {active === item.id && <span class="capsule" aria-hidden="true" />}
        <span class="icon"><Icon name={item.icon} /></span>
        <span>
          {item.label}
          {item.id === "plan" && <span class="count" data-plan-count hidden />}
        </span>
      </a>
    ))
  }
</nav>

<!-- During the week, Schedule links straight to today's page: /schedule/
     redirects there, and a redirect would cancel the page transition. -->
<script is:inline>
  (() => {
    const nav = document.currentScript.previousElementSibling;
    const days = JSON.parse(nav.dataset.days || "[]");
    const today = new Intl.DateTimeFormat("en-CA", { timeZone: "America/Chicago" }).format(new Date());
    const link = nav.querySelector('a[href="/schedule/"]');
    if (link && days.includes(today)) link.href = `/schedule/${today}/`;
  })();
</script>

<style>
  .app-nav {
    position: fixed;
    left: var(--tabbar-gap);
    right: var(--tabbar-gap);
    bottom: calc(env(safe-area-inset-bottom) + var(--tabbar-gap));
    z-index: 20;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    height: var(--tabbar-height);
    padding: 4px;
    border-radius: 999px;
    /* Glass: the page shows through, blurred and a little richer. */
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    box-shadow:
      var(--glass-shadow),
      inset 0 1px 0 var(--glass-highlight),
      inset 0 0 0 1px var(--glass-edge);
    view-transition-name: tab-bar;
  }
  a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    min-height: var(--tap);
    border-radius: 999px;
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 500;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  a[aria-current="page"] {
    color: var(--accent);
    font-weight: 600;
  }
  /* The lens behind the current tab. */
  .capsule {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--glass-capsule);
    box-shadow: inset 0 1px 0 var(--glass-highlight);
    view-transition-name: tab-capsule;
  }
  .icon {
    display: inline-grid;
  }
  .count:not([hidden])::before {
    content: " · ";
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Pressing a tab squeezes it a little; letting go springs it back. */
    .icon,
    .capsule {
      transition: transform 380ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    a:active .icon {
      transform: scale(0.86);
      transition-duration: 90ms;
    }
    a:active .capsule {
      transform: scale(1.06);
      transition-duration: 120ms;
    }
  }

  /* Without see-through effects (or when they're turned off), a solid bar. */
  @media (prefers-reduced-transparency: reduce) {
    .app-nav {
      background: var(--surface);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .app-nav {
      background: var(--surface);
    }
  }
  @media (forced-colors: active) {
    .app-nav {
      border: 1px solid CanvasText;
    }
    .capsule {
      border: 1px solid Highlight;
    }
  }

  @media (min-width: 1024px) {
    .app-nav {
      inset: 0 auto 0 0;
      width: 88px;
      height: auto;
      grid-template-columns: 1fr;
      grid-auto-rows: 72px;
      align-content: start;
      gap: var(--space-1);
      padding: var(--space-6) var(--space-2) 0;
      border-radius: 0;
      box-shadow: none;
      border-right: 1px solid var(--line);
    }
    a {
      border-radius: var(--radius-md);
    }
  }
</style>
