---
import "../styles/global.css";
import AppNav, { type Section } from "../components/AppNav.astro";
import { UPDATED_AT } from "../lib/build-info";
import { formatDate, formatTime } from "../lib/time";
// The two weights every page uses, preloaded so text doesn't swap fonts mid-load.
import plexSans400 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import plexMono500 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  /** Which tab to highlight. */
  active?: Section;
}

const {
  title,
  description = "Plan your AfroTech 2026 week: the official schedule, community side events and a map of the convention center.",
  active = "none",
} = Astro.props;
const updatedLabel = `${formatDate(UPDATED_AT)}, ${formatTime(UPDATED_AT)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <!-- Meta tags can't read CSS variables: these copy --bg from tokens.css. -->
    <meta name="theme-color" content="#faf6f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161015" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="AfroTech 26" />
    <link rel="preload" href={plexSans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono500} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <!-- Name each page change for the view transitions in global.css (plan 0010):
         "tab" between sections, "push" deeper, "pop" back. Runs before first
         paint because pagereveal fires then. -->
    <script is:inline>
      (() => {
        const KEY = "afrotech:last-path";
        // Tab pages are depth 0; anything opened from them (an event, a speaker,
        // a note, search) is deeper.
        const depth = (path) =>
          /^\/(schedule\/(\d{4}-\d{2}-\d{2}\/)?|map\/(city\/)?|plan\/|notes\/|speakers\/)?$/.test(path)
            ? 0
            : path.split("/").filter(Boolean).length;
        addEventListener("pageswap", () => {
          try { sessionStorage.setItem(KEY, location.pathname); } catch {}
        });
        addEventListener("pagereveal", (e) => {
          let from = null;
          try { from = sessionStorage.getItem(KEY); } catch {}
          const types = e.viewTransition && e.viewTransition.types;
          if (!types || !from || from === location.pathname) return;
          const a = depth(from), b = depth(location.pathname);
          // Back and forward in history, where the browser tells us (Chrome).
          const act = window.navigation && navigation.activation;
          const back = act && act.navigationType === "traverse" && act.from && act.entry && act.entry.index < act.from.index;
          if (back) types.add(b === 0 && a === 0 ? "tab" : "pop");
          else if (b > a || (b > 0 && a === b)) types.add("push"); // deeper, or one detail page to another
          else types.add(b < a ? "pop" : "tab");
        });
      })();
    </script>
    <!-- Apply a saved theme before first paint, so dark mode never flashes light. -->
    <script is:inline>
      try {
        const theme = JSON.parse(localStorage.getItem("afrotech:prefs") || "{}").theme;
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <AppNav active={active} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <div class="visually-hidden" aria-live="polite" data-announce></div>
    <div class="notices">
      <p class="notice offline" role="status" data-offline hidden>
        Offline. Showing saved pages from {updatedLabel}.
      </p>
      <p class="notice update" role="status" data-update hidden>
        <span>A newer version is ready.</span>
        <button type="button">Tap to reload</button>
      </p>
    </div>
    <script>
      import "../scripts/plan-ui";
      import "../scripts/plan-sync";
      import "../scripts/notes-ui";
      import "../scripts/notes-sync";
      import "../scripts/sticky";
      import "../scripts/sw-register";
      import "../scripts/offline-banner";
      import "../scripts/directions";
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 50;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: none;
  }
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 var(--space-4) calc(var(--tabbar-height) + var(--tabbar-gap) + env(safe-area-inset-bottom) + var(--space-8));
  }
  /* Notices sit just above the tab bar (or at the bottom on desktop). */
  .notices {
    position: fixed;
    left: 0;
    right: 0;
    bottom: calc(var(--tabbar-height) + var(--tabbar-gap) + env(safe-area-inset-bottom));
    z-index: 15;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: 0 var(--space-2) var(--space-2);
    pointer-events: none;
  }
  .notice {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: 720px;
    width: 100%;
    margin: 0 auto;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--shadow);
    font-size: var(--text-sm);
    pointer-events: auto;
  }
  .notice.offline {
    color: var(--warn);
    font-weight: 600;
  }
  .notice button {
    flex: none;
    min-height: var(--tap);
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    cursor: pointer;
  }
  @media (min-width: 1024px) {
    .notices {
      bottom: 0;
      left: 88px;
    }
  }
  main:focus {
    outline: none;
  }
  @media (min-width: 1024px) {
    main {
      margin-left: max(88px + var(--space-8), calc((100vw - 720px) / 2));
      padding-bottom: var(--space-12);
    }
  }
</style>
