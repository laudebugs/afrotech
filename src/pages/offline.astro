---
// Shown when you're offline and the page you asked for isn't saved yet.
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Offline · AfroTech 2026 Planner" active="none">
  <h1>You're offline</h1>
  <p>This page isn't saved on your device yet. These are, and work without a connection:</p>
  <ul>
    <li><a href="/">Now</a>: what's on and what's next</li>
    <li><a href="/schedule/">Schedule</a>: every day of the week</li>
    <li><a href="/plan/">My plan</a>, including the events you've starred</li>
    <li><a href="/map/">Map</a> of the convention center</li>
  </ul>
  <p class="muted">Pages you open while online are saved too.</p>
</BaseLayout>

<style>
  h1 {
    margin: var(--space-12) 0 var(--space-4);
    font-size: var(--text-2xl);
  }
  li {
    margin: var(--space-2) 0;
  }
  li a {
    font-weight: 600;
  }
</style>
