---
import BaseLayout from "../layouts/BaseLayout.astro";
import { officialEvents, sideEvents } from "../lib/events";
---

<BaseLayout title="AfroTech 2026 Planner" active="now">
    <h1>AfroTech 2026 Planner</h1>
    <p>
      The schedule, side events and convention center map for AfroTech 2026 in
      Houston, November 2–6, land here this week: {officialEvents.length} official
      sessions and {sideEvents.length} side events so far.
    </p>
    <p>
      Until then, read the
      <a href="https://github.com/laudebugs/afrotech/blob/main/schedule/official.md">official schedule</a>
      and the
      <a href="https://github.com/laudebugs/afrotech/blob/main/schedule/side-events.md">side events</a>
      on GitHub.
    </p>
</BaseLayout>

<style>
  h1 {
    margin: var(--space-12) 0 var(--space-4);
    font-size: var(--text-2xl);
  }
</style>
