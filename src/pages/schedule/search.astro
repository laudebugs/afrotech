---
// Search the whole week (plan 0009, todos 037–039): events and speakers
// matched in the browser from /search-index.json, events grouped by day, and
// your notes, searched on this device only. The address holds the words
// (?q=…), so back, forward and shared links work.
import "../../styles/event-rows.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import Filters from "../../components/Filters.astro";
import { sideCategories } from "../../lib/schedule";
---

<BaseLayout title="Search · Schedule · AfroTech 2026 Planner" active="schedule">
  <header class="page-head sticky-head">
    <p class="back"><a href="/schedule/">← Schedule</a></p>
    <form class="box" role="search" data-form>
      <Icon name="search" size={20} />
      <label class="visually-hidden" for="q">Search the whole week</label>
      <input
        id="q"
        type="search"
        enterkeyhint="search"
        autocomplete="off"
        placeholder="Events, speakers, hosts, places"
        autofocus
        data-q
      />
    </form>
    <div class="filters"><Filters scope="week" cats={sideCategories} /></div>
    <p class="status muted" data-status>Loading the week's events…</p>
    <!-- Read out once typing pauses, not for every letter. -->
    <p class="visually-hidden" aria-live="polite" data-announce-count></p>
  </header>

  <section class="recent" data-recent hidden aria-labelledby="recent-title">
    <div class="recent-head">
      <h2 id="recent-title">Recent searches</h2>
      <button type="button" class="link" data-clear-recent>Clear</button>
    </div>
    <ul data-recent-list></ul>
  </section>

  <section class="extra" data-speakers hidden aria-labelledby="speakers-title">
    <h2 id="speakers-title">Speakers</h2>
    <ul class="links" data-speaker-list></ul>
  </section>
  <section class="extra" data-notes hidden aria-labelledby="notes-title">
    <h2 id="notes-title">Your notes</h2>
    <ul class="links" data-note-list></ul>
  </section>

  <div data-results></div>
  <button type="button" class="button more" data-more hidden>Show more</button>
</BaseLayout>

<script>
  import {
    eventSearch,
    findEvents,
    findNotes,
    findSpeakers,
    noteSearch,
    noteText,
    speakerSearch,
    type SearchEvent,
    type SearchIndex,
    type SearchSpeaker,
  } from "../../lib/search";
  import { listNotes } from "../../lib/notes";
  import { activeCount, matches, type FilterContext, type Filters } from "../../lib/filters";
  import { initFilters } from "../../scripts/filters-ui";
  import { readPlan } from "../../lib/plan";
  import { eventRow } from "../../scripts/event-rows";
  import { syncPlan } from "../../scripts/plan-ui";
  import { getItem, setItem } from "../../lib/storage";
  import { dayKey, eventEndMs, formatDate, formatRange, previewNow } from "../../lib/time";

  const RECENT = "afrotech:recent-searches";
  const PAGE = 60;

  const input = document.querySelector<HTMLInputElement>("[data-q]")!;
  const status = document.querySelector<HTMLElement>("[data-status]")!;
  const results = document.querySelector<HTMLElement>("[data-results]")!;
  const more = document.querySelector<HTMLButtonElement>("[data-more]")!;
  const recent = document.querySelector<HTMLElement>("[data-recent]")!;
  const recentList = document.querySelector<HTMLElement>("[data-recent-list]")!;

  let ms: ReturnType<typeof eventSearch> | null = null;
  let sms: ReturnType<typeof speakerSearch> | null = null;
  let speakersBySlug = new Map<string, SearchSpeaker>();
  let byId = new Map<string, SearchEvent>();
  let found: SearchEvent[] = [];
  let shown = 0;

  // --- Recent searches, kept on this device ---------------------------------
  const readRecent = (): string[] => {
    try {
      const list = JSON.parse(getItem(RECENT) ?? "[]");
      return Array.isArray(list) ? list.filter((x): x is string => typeof x === "string") : [];
    } catch {
      return [];
    }
  };
  function remember(q: string) {
    const words = q.trim();
    if (words.length < 2) return;
    const list = [words, ...readRecent().filter((x) => x.toLowerCase() !== words.toLowerCase())].slice(0, 8);
    setItem(RECENT, JSON.stringify(list));
  }
  function showRecent() {
    const list = readRecent();
    recent.hidden = input.value.trim() !== "" || list.length === 0;
    recentList.replaceChildren(
      ...list.map((q) => {
        const li = document.createElement("li");
        const b = document.createElement("button");
        b.type = "button";
        b.className = "recent-item";
        b.textContent = q;
        b.addEventListener("click", () => {
          input.value = q;
          run(true);
        });
        li.append(b);
        return li;
      }),
    );
  }
  document.querySelector("[data-clear-recent]")!.addEventListener("click", () => {
    setItem(RECENT, null);
    showRecent();
  });

  // --- Results, grouped by day -----------------------------------------------
  function when(e: SearchEvent): string {
    const time = e.start ? formatRange(e.start, e.end) : "Time TBA";
    return `${time} · ${e.place.split(" · ")[0] || "Place TBA"}`;
  }

  function render(from: number) {
    const now = previewNow();
    const slice = found.slice(from, from + PAGE);
    // Days in the order their first result appears, so the best matches lead.
    for (const e of slice) {
      const key = e.date;
      let list = results.querySelector<HTMLUListElement>(`ul[data-day="${key}"]`);
      if (!list) {
        const section = document.createElement("section");
        section.className = "day";
        const h = document.createElement("h2");
        h.textContent = formatDate(`${key}T12:00:00-06:00`);
        list = document.createElement("ul");
        list.className = "event-rows";
        list.dataset.day = key;
        section.append(h, list);
        results.append(section);
      }
      const ended = e.start ? eventEndMs(e.start, e.end) <= now : false;
      const kind = e.kind === "side" ? "Side event" : (e.track ?? "Official session");
      list.append(eventRow({ id: e.id, title: e.title, before: when(e), after: [ended ? `${kind} · ended` : kind] }));
    }
    shown = from + slice.length;
    more.hidden = shown >= found.length;
    syncPlan(results);
  }

  // --- Speakers and your notes, above the events ------------------------------
  const SHOW_FIRST = 4;
  function linkList(
    section: HTMLElement,
    items: { href: string; title: string; detail: string }[],
  ) {
    const list = section.querySelector("ul")!;
    section.hidden = items.length === 0;
    const make = (it: (typeof items)[number]) => {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = it.href;
      const strong = document.createElement("strong");
      strong.textContent = it.title;
      const span = document.createElement("span");
      span.className = "muted";
      span.textContent = it.detail;
      a.append(strong, span);
      li.append(a);
      return li;
    };
    list.replaceChildren(...items.slice(0, SHOW_FIRST).map(make));
    if (items.length > SHOW_FIRST) {
      const li = document.createElement("li");
      const all = document.createElement("button");
      all.type = "button";
      all.className = "all";
      all.textContent = `Show all ${items.length}`;
      all.addEventListener("click", () => list.replaceChildren(...items.map(make)));
      li.append(all);
      list.append(li);
    }
  }

  // Built once, and again only when notes change (notes-change below).
  let notesCache: { nms: ReturnType<typeof noteSearch>; byNote: Map<string, ReturnType<typeof listNotes>[number]> } | null =
    null;
  function notesIndex() {
    if (!notesCache) {
      const notes = listNotes();
      notesCache = {
        byNote: new Map(notes.map((n) => [n.id, n])),
        nms: noteSearch(notes.map((n) => ({ id: n.id, title: n.title || "Untitled note", text: noteText(n.body) }))),
      };
    }
    return notesCache;
  }

  /** Whether speakers or notes were found, for the status line. */
  function showExtras(q: string): boolean {
    const speakersSection = document.querySelector<HTMLElement>("[data-speakers]")!;
    const notesSection = document.querySelector<HTMLElement>("[data-notes]")!;
    if (!q || !sms) {
      speakersSection.hidden = notesSection.hidden = true;
      return false;
    }
    const people = findSpeakers(sms, q)
      .map((slug) => speakersBySlug.get(slug)!)
      .filter(Boolean)
      .map((sp) => ({
        href: `/speakers/${sp.slug}/`,
        title: sp.name,
        detail: [sp.title, sp.company].filter(Boolean).join(", "),
      }));
    linkList(speakersSection, people);
    // Notes come from this device and are searched here; nothing is sent.
    const { nms, byNote } = notesIndex();
    const found = findNotes(nms, q);
    linkList(
      notesSection,
      found.map((id) => {
        const n = byNote.get(id)!;
        const text = noteText(n.body);
        return {
          href: `/notes/view/?id=${encodeURIComponent(id)}`,
          title: n.title.trim() || "Untitled note",
          detail: text.length > 90 ? `${text.slice(0, 90)}…` : text,
        };
      }),
    );
    return people.length + found.length > 0;
  }

  const announce = document.querySelector<HTMLElement>("[data-announce-count]")!;
  let announceTimer = 0;
  function say(text: string) {
    status.textContent = text;
    clearTimeout(announceTimer);
    announceTimer = window.setTimeout(() => (announce.textContent = text), 700);
  }

  // Letters or digits make a search; "&" on its own doesn't yet.
  const hasWords = (q: string) => /[\p{L}\p{N}]/u.test(q);

  function context(): FilterContext {
    const now = previewNow();
    const planned = new Set(readPlan());
    const plannedSpans = [...planned]
      .map((id) => byId.get(id))
      .filter((e): e is SearchEvent => Boolean(e?.start))
      .map((e) => ({ id: e.id, start: Date.parse(e.start!), end: eventEndMs(e.start!, e.end) }));
    return { now, today: dayKey(new Date(now)), planned, plannedSpans };
  }

  /** Events for the words (or all, best-first) that pass the filters. */
  function select(q: string, f: Filters): SearchEvent[] {
    if (!ms) return [];
    const ctx = context();
    return findEvents(ms, byId, q, ctx.now).filter((e) => matches(e, f, ctx));
  }

  const filters = initFilters({
    count: (f) => select(hasWords(input.value) ? input.value : "", f).length,
    onChange: () => run(),
  });

  let typingTimer = 0;
  function run(commit = false) {
    const q = hasWords(input.value) ? input.value : "";
    const f = filters.get();
    const url = new URL(location.href);
    if (q.trim()) url.searchParams.set("q", q.trim());
    else url.searchParams.delete("q");
    history.replaceState(null, "", url);
    showRecent();
    results.replaceChildren();
    more.hidden = true;
    if (!ms) return;
    const others = showExtras(q.trim());
    if (!q.trim() && activeCount(f) === 0) {
      found = [];
      say(`Search ${byId.size} events across the week by title, speaker, host or place.`);
      return;
    }
    found = select(q, f);
    say(
      found.length
        ? `${found.length} ${found.length === 1 ? "event" : "events"}`
        : others
          ? "No events match."
          : activeCount(f)
            ? "No events match. Try fewer filters or words."
            : "No events match. Try fewer or shorter words.",
    );
    render(0);
    clearTimeout(typingTimer);
    if (!q) return;
    if (commit) remember(q);
    // A pause in typing counts as a finished search.
    else typingTimer = window.setTimeout(() => found.length && remember(q), 1500);
  }

  more.addEventListener("click", () => render(shown));
  input.addEventListener("input", () => run());
  document.querySelector("[data-form]")!.addEventListener("submit", (e) => {
    e.preventDefault();
    run(true);
    input.blur(); // hide the phone keyboard to show the results
  });
  // Notes synced or edited in another tab show up in the next search.
  document.addEventListener("notes-change", () => {
    notesCache = null;
    showExtras(hasWords(input.value) ? input.value.trim() : "");
  });
  // Starring changes what "In my plan" and "Doesn't clash" keep.
  document.addEventListener("plan-change", () => {
    const f = filters.get();
    if (f.plan || f.noclash) run();
    else syncPlan(results);
  });

  input.value = new URLSearchParams(location.search).get("q") ?? "";
  showRecent();

  fetch("/search-index.json")
    .then((res) => {
      if (!res.ok) throw new Error(String(res.status));
      return res.json() as Promise<SearchIndex>;
    })
    .then((index) => {
      byId = new Map(index.events.map((e) => [e.id, e]));
      ms = eventSearch(index.events);
      sms = speakerSearch(index.speakers);
      speakersBySlug = new Map(index.speakers.map((sp) => [sp.slug, sp]));
      run();
      filters.refreshCount();
    })
    .catch(() => {
      status.textContent = "Search couldn't load. Check your connection and try again.";
    });
</script>

<style>
  .back a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 600;
    text-decoration: none;
  }
  .box {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: 0 var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--muted);
  }
  .box:focus-within {
    border-color: var(--accent);
  }
  .box input {
    flex: 1;
    min-width: 0;
    min-height: var(--tap);
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: var(--text-md);
    outline: none;
  }
  .filters {
    margin-top: var(--space-3);
  }
  .status {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
  }
  .recent {
    margin-top: var(--space-4);
  }
  .recent-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .recent h2,
  :global(.day) h2 {
    margin: var(--space-4) 0 var(--space-2);
    font-size: var(--text-md);
  }
  .recent ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Made by the script, so outside the page's scoped styles. */
  .recent :global(.recent-item),
  .link {
    min-height: var(--tap);
    padding: 0 var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
  }
  .link {
    border: 0;
    background: none;
    color: var(--accent);
    font-weight: 600;
  }
  .extra h2 {
    margin: var(--space-4) 0 var(--space-2);
    font-size: var(--text-md);
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* The lists are filled by the script, outside the page's scoped styles. */
  .links :global(a) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: var(--tap);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }
  .links :global(.muted) {
    font-size: var(--text-sm);
  }
  .links :global(.all) {
    min-height: var(--tap);
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .more {
    display: flex;
    justify-content: center;
    width: 100%;
    min-height: var(--tap);
    margin: var(--space-4) 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .more[hidden] {
    display: none;
  }
</style>
