---
// One day's events on the timeline, with filters and search kept in the URL.
import "../../styles/event-detail.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import Filters from "../../components/Filters.astro";
import Timeline from "../../components/Timeline.astro";
import TimelineRow from "../../components/TimelineRow.astro";
import TimeHeader from "../../components/TimeHeader.astro";
import EventCard from "../../components/EventCard.astro";
import BottomSheet from "../../components/BottomSheet.astro";
import SourcesFooter from "../../components/SourcesFooter.astro";
import { dayLabel, eventsOnDay, groupByHour, scheduleDays, sideCategories } from "../../lib/schedule";
import { buildSearchIndex } from "../../lib/search-index";
import { formatClock, formatDate } from "../../lib/time";

export function getStaticPaths() {
  return scheduleDays.map((day) => ({ params: { day } }));
}

const { day } = Astro.params as { day: string };
const events = eventsOnDay(day);
// What the shared filters need about each event (plan 0009).
const filterData = new Map(
  buildSearchIndex().events.map((e) => [
    e.id,
    JSON.stringify({ id: e.id, date: e.date, start: e.start, end: e.end, kind: e.kind, track: e.track,
      cats: e.cats, free: e.free, access: e.access, where: e.where, pick: e.pick }),
  ]),
);
const groups = groupByHour(events);
// Noon on the day keeps the date label right in Houston.
const dateLabel = formatDate(`${day}T12:00:00-06:00`);
const shortDay = (d: string) => formatDate(`${d}T12:00:00-06:00`).replace(/,.*?(\d+)$/, " $1");
---

<BaseLayout title={`${dateLabel} · Schedule · AfroTech 2026 Planner`} active="schedule">
  <header class="page-head sticky-head">
    <div class="title-row">
      <h1>{dateLabel}</h1>
      <span class="muted mono">{dayLabel(day)}</span>
    </div>

    <nav class="days" aria-label="Days">
      {
        scheduleDays.map((d) => (
          <a href={`/schedule/${d}/`} aria-current={d === day ? "page" : undefined} data-day-link>
            {shortDay(d)}
          </a>
        ))
      }
    </nav>
  </header>

  <div class="filters" data-day={day}>
    <Filters scope="day" cats={sideCategories} />
    <!-- Search covers the whole week, on its own page (plan 0009). -->
    <a class="week-search" href="/schedule/search/">
      <Icon name="search" size={18} />
      <span>Search the whole week</span>
    </a>
    <p class="count muted" aria-live="polite" data-count>{events.length} events</p>
  </div>

  <Timeline label={`Events on ${dateLabel}`}>
    {
      groups.map((group) => (
        <section class="group" data-group aria-label={group.label}>
          <TimeHeader label={group.label} />
          {group.events.map((event) => (
            <TimelineRow
              time={event.start ? formatClock(event.start) : (event.timeLabel ?? "TBA")}
              datetime={event.start ?? undefined}
              data-row
              data-event-id={event.id}
              data-start={event.start ?? undefined}
              data-end={event.end ?? undefined}
              data-filter={filterData.get(event.id)}
            >
              <EventCard event={event} />
            </TimelineRow>
          ))}
        </section>
      ))
    }
  </Timeline>

  <div class="empty" data-empty hidden>
    <p>No events match these filters.</p>
    <button type="button" class="reset" data-reset>Clear filters</button>
  </div>

  <BottomSheet id="event-sheet" label="Event details">
    <div data-sheet-body></div>
  </BottomSheet>

  <SourcesFooter />
</BaseLayout>

<script>
  import { readPlan } from "../../lib/plan";
  import { HOUR_MS, dayKey, eventEndMs, previewNow } from "../../lib/time";
  import { NO_FILTERS, matches, type FilterContext, type FilterEvent, type Filters } from "../../lib/filters";
  import { initFilters } from "../../scripts/filters-ui";

  const rows = [...document.querySelectorAll<HTMLElement>("[data-row]")];
  const groups = [...document.querySelectorAll<HTMLElement>("[data-group]")];
  const count = document.querySelector<HTMLElement>("[data-count]")!;
  const empty = document.querySelector<HTMLElement>("[data-empty]")!;
  const data = new Map(rows.map((r) => [r, JSON.parse(r.dataset.filter!) as FilterEvent]));

  // Links from before week-wide search (?q=…) go on to the search page.
  const oldQuery = new URLSearchParams(location.search).get("q");
  if (oldQuery) location.replace(`/schedule/search/?q=${encodeURIComponent(oldQuery)}`);

  // Planned events' times come from this page and the plan; events on other
  // days can't clash with this one's.
  function context(): FilterContext {
    const now = previewNow();
    const planned = new Set(readPlan());
    const plannedSpans = [...data.values()]
      .filter((e) => planned.has(e.id) && e.start)
      .map((e) => ({ id: e.id, start: Date.parse(e.start!), end: eventEndMs(e.start!, e.end) }));
    return { now, today: dayKey(new Date(now)), planned, plannedSpans };
  }

  const shownBy = (f: Filters) => {
    const ctx = context();
    return rows.filter((r) => matches(data.get(r)!, f, ctx));
  };

  function apply(f: Filters) {
    const keep = new Set(shownBy(f));
    for (const row of rows) row.hidden = !keep.has(row);
    groups.forEach((g) => (g.hidden = !g.querySelector("[data-row]:not([hidden])")));
    count.textContent = `${keep.size} ${keep.size === 1 ? "event" : "events"}`;
    empty.hidden = keep.size > 0;
    // Switching days keeps the filters.
    document.querySelectorAll<HTMLAnchorElement>("[data-day-link]").forEach((a) => (a.search = location.search));
  }

  const pageDayKey = document.querySelector<HTMLElement>("[data-day]")!.dataset.day;
  const filters = initFilters({
    count: (f) => shownBy(f).length,
    onChange: apply,
    isToday: pageDayKey === dayKey(new Date(previewNow())),
  });
  document.querySelector("[data-reset]")!.addEventListener("click", () => filters.set({ ...NO_FILTERS }));
  // Starring changes what "In my plan" and "Doesn't clash" keep.
  document.addEventListener("plan-change", () => apply(filters.get()));

  const openedAt = previewNow();
  apply(filters.get());

  // On today's page, open at the current hour: the first shown event starting
  // this hour or later (all-day events like registration stay above), else the
  // first one still running. A Back/Forward visit, a reload or a #link keeps
  // the browser's own position.
  const firstShown = (scope: ParentNode) => scope.querySelector<HTMLElement>("[data-row]:not([hidden])");
  const navigation = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
  const pageDay = document.querySelector<HTMLElement>("[data-day]")!.dataset.day;
  if (!location.hash && navigation?.type === "navigate" && pageDay === dayKey(new Date(openedAt))) {
    const hourStart = openedAt - (openedAt % HOUR_MS); // Houston is a whole-hour offset
    const shown = rows.filter((r) => !r.hidden && r.dataset.start);
    const current =
      shown.find((r) => Date.parse(r.dataset.start!) >= hourStart) ??
      shown.find((r) => openedAt < eventEndMs(r.dataset.start!, r.dataset.end));
    // Before the day starts the current event is the first, and the top is right.
    if (current && current !== firstShown(document)) {
      // The first event of an hour scrolls with its hour label.
      const group = current.closest<HTMLElement>("[data-group]")!;
      const target = firstShown(group) === current ? group : current;
      // Wait for the fonts, which change the height of everything above, but
      // leave the page alone if the reader has started scrolling by then.
      const startY = scrollY;
      document.fonts.ready.then(() =>
        requestAnimationFrame(() => {
          if (scrollY === startY) target.scrollIntoView({ block: "start" });
        }),
      );
    }
  }

  // Open event details in the bottom sheet; the link still works without JS.
  const sheet = document.querySelector<HTMLDialogElement>("#event-sheet")!;
  const body = sheet.querySelector<HTMLElement>("[data-sheet-body]")!;
  let request = 0;

  document.querySelector(".timeline")!.addEventListener("click", async (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[href^="/event/"]');
    const click = e as MouseEvent;
    if (!link || click.metaKey || click.ctrlKey || click.shiftKey || click.button !== 0) return;
    e.preventDefault();

    // Open at once with a loading line, so a slow network still feels responsive.
    const mine = ++request;
    const loading = document.createElement("p");
    loading.className = "muted";
    loading.textContent = "Loading…";
    body.replaceChildren(loading);
    if (!sheet.open) sheet.showModal();

    try {
      const res = await fetch(link.href);
      if (!res.ok) throw new Error(String(res.status));
      const doc = new DOMParser().parseFromString(await res.text(), "text/html");
      if (mine !== request) return; // a later tap won
      const detail = doc.querySelector("[data-event-detail]");
      if (!detail) throw new Error("no detail");
      // The page's h1 becomes an h2 here, under this page's own h1.
      const title = detail.querySelector("h1");
      if (title) {
        const h2 = document.createElement("h2");
        h2.className = title.className;
        h2.append(...title.childNodes);
        title.replaceWith(h2);
      }
      body.replaceChildren(document.importNode(detail, true));
    } catch {
      if (mine === request) location.href = link.href;
    }
  });
</script>

<style>
  /* Scrolling to an event leaves room for the sticky header and hour label. */
  .timeline :global([data-row]) {
    scroll-margin-top: calc(var(--sticky-offset, 0px) + var(--space-12));
  }
  .group {
    scroll-margin-top: var(--sticky-offset, 0px);
  }
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }
  h1 {
    margin: 0;
    font-size: var(--text-2xl);
  }
  .days {
    display: flex;
    gap: var(--space-1);
    margin: var(--space-2) calc(var(--space-4) * -1) 0;
    padding: 0 var(--space-4);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .days a {
    font-family: var(--font-mono);
    font-weight: 500;
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .days a[aria-current="page"] {
    background: var(--surface);
    border: 1px solid var(--accent);
    color: var(--ink);
    font-weight: 600;
  }
  .filters {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .week-search {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: 0 var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--muted);
    font-size: var(--text-md);
    text-decoration: none;
  }
  .week-search:hover {
    border-color: var(--accent);
  }
  .count {
    margin: 0;
    font-size: var(--text-sm);
  }
  .group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .group[hidden] {
    display: none;
  }
  .empty {
    padding: var(--space-8) 0;
    text-align: center;
  }
  .reset {
    min-height: var(--tap);
    padding: 0 var(--space-4);
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--accent);
    font-weight: 600;
    cursor: pointer;
  }
</style>
