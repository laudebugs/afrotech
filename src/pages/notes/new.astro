---
// Write or edit a note (plan 0005). /notes/new/?event=<id> starts a note on a
// session; /notes/new/?id=<note> edits one. Notes save on the device as you
// type, and sync to your account when you're signed in. The editor is Tiptap
// (plan 0006), reading and writing Markdown; "Markdown" shows the raw text.
import "../../styles/notes.css";
import "../../styles/note-prose.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NoteEventLookup from "../../components/NoteEventLookup.astro";
import { MAX_BODY, MAX_TITLE } from "../../lib/notes";
---

<BaseLayout title="Write a note · AfroTech 2026 Planner" active="plan">
  <div class="notes-page">
    <header class="page-head sticky-head">
      <p class="back"><a href="/notes/">← Notes</a></p>
      <h1 data-heading>Write a note</h1>
      <p class="muted small" data-about></p>
    </header>

    <form class="editor" data-editor>
      <label>
        <span>Title</span>
        <input name="title" maxlength={MAX_TITLE} data-title />
      </label>
      <div class="field">
        <div class="field-head">
          <span id="note-label">Note</span>
          <button type="button" class="mode" aria-pressed="false" data-source-toggle>Markdown</button>
        </div>
        <div class="toolbar-slot">
          <div class="toolbar" role="toolbar" aria-label="Formatting" aria-controls="note-editor" data-toolbar>
            <div class="tools" data-tools></div>
            <div class="panel" id="toolbar-panel" data-panel hidden></div>
          </div>
        </div>
        <div class="body-editor" id="note-editor" data-body-editor></div>
        <textarea
          class="source"
          rows="16"
          maxlength={MAX_BODY}
          aria-labelledby="note-label"
          spellcheck="false"
          data-source
          hidden></textarea>
      </div>
      <p class="muted small" data-saved></p>
      <p class="small warn" role="alert" data-save-problem hidden></p>
      <p class="small warn" role="alert" data-photos-full hidden>
        Your account's photo space (200 MB) is full, so new photos stay on this device only. Delete notes
        with photos you no longer need to make room.
      </p>
      <div class="buttons">
        <button type="submit" class="button primary">Done</button>
        <button type="button" class="button" data-delete hidden>Delete note</button>
      </div>
      <p class="muted small">
        Only you can see your notes. They save on this device as you type; sign in on{" "}
        <a href="/notes/">Saved</a> to keep them on all your devices.
      </p>
    </form>
  </div>
  <NoteEventLookup withSpeakers />
</BaseLayout>

<script>
  import { MAX_BODY, NOTE_TEMPLATE, deleteNote, getNote, notesPersist, saveNote } from "../../lib/notes";
  import { noteEvent } from "../../lib/note-events";
  import { formatTime } from "../../lib/time";
  import { countWords, createNoteEditor } from "../../scripts/note-editor";
  import { attachToolbar } from "../../scripts/note-toolbar";
  import { PHOTO_PREFIX, photoUrl } from "../../lib/photos";
  import { fetchPhotoFromAccount } from "../../scripts/photo-fetch";
  import { photosSyncProblem } from "../../scripts/photos-sync";

  const params = new URLSearchParams(location.search);
  const editing = getNote(params.get("id") ?? "");
  // A new note links to a session only if the link names a real one.
  const asked = params.get("event") ?? "";
  const eventId = editing?.eventId ?? (noteEvent(asked) ? asked : "");
  const info = noteEvent(eventId);

  const form = document.querySelector<HTMLFormElement>("[data-editor]")!;
  const titleInput = document.querySelector<HTMLInputElement>("[data-title]")!;
  const source = document.querySelector<HTMLTextAreaElement>("[data-source]")!;
  const sourceToggle = document.querySelector<HTMLButtonElement>("[data-source-toggle]")!;
  const saved = document.querySelector<HTMLElement>("[data-saved]")!;
  const problem = document.querySelector<HTMLElement>("[data-save-problem]")!;
  const removeButton = document.querySelector<HTMLButtonElement>("[data-delete]")!;

  if (info) document.querySelector("[data-about]")!.textContent = `${info.title} · ${info.when} · ${info.place}`;
  if (editing) {
    document.querySelector("[data-heading]")!.textContent = "Edit note";
    document.title = `Edit note · AfroTech 2026 Planner`;
  }

  // The note gets an id on its first save, so opening the editor and leaving
  // creates nothing.
  let noteId = editing?.id;
  titleInput.value = editing?.title ?? (info ? `Takeaways: ${info.title}` : "");
  removeButton.hidden = !noteId;

  const editorBox = document.querySelector<HTMLElement>("[data-body-editor]")!;
  const body = createNoteEditor({
    element: editorBox,
    markdown: editing?.body ?? NOTE_TEMPLATE,
    labelledBy: "note-label",
    resolveImage: (src) => photoUrl(src.slice(PHOTO_PREFIX.length), fetchPhotoFromAccount),
    onChange: changed,
  });

  // Uploads stopped because the account's photo space is full.
  const photosFull = document.querySelector<HTMLElement>("[data-photos-full]")!;
  const showPhotosFull = () => (photosFull.hidden = photosSyncProblem() !== "full");
  document.addEventListener("photos-full", showPhotosFull);
  showPhotosFull();

  const toolbar = document.querySelector<HTMLElement>("[data-toolbar]")!;
  attachToolbar({ root: toolbar, editor: body.editor, eventId });

  // The Markdown view edits the raw text. Switching back re-reads it only if
  // you changed it, so a look at the Markdown never rewrites the note.
  let showingSource = false;
  let shownMarkdown = "";
  const bodyMarkdown = () => (showingSource ? source.value : body.getMarkdown());
  sourceToggle.addEventListener("click", () => {
    showingSource = !showingSource;
    if (showingSource) source.value = shownMarkdown = body.getMarkdown();
    else if (source.value !== shownMarkdown) body.setMarkdown(source.value);
    source.hidden = !showingSource;
    editorBox.hidden = showingSource;
    toolbar.parentElement!.hidden = showingSource; // its tools act on the formatted view
    sourceToggle.setAttribute("aria-pressed", String(showingSource));
    if (showingSource) source.focus();
    else body.focus();
  });

  // Both views count words in the text without Markdown syntax.
  const words = () => {
    const n = countWords(showingSource ? source.value.replace(/[#>*_`~|[\]()-]+/g, " ") : body.getText());
    return `${n} ${n === 1 ? "word" : "words"}`;
  };

  // Signing out in another tab removes notes from this device; this editor
  // must not write its note back afterwards.
  let closed = false;
  window.addEventListener("storage", (e) => {
    if ((e.key === "afrotech:notes" || e.key === null) && e.newValue === null && !closed) {
      closed = true;
      clearTimeout(timer);
      timer = 0;
      body.lock();
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLButtonElement>("input, textarea, button").forEach(
        (el) => (el.disabled = true),
      );
      problem.hidden = true;
      saved.textContent = "You signed out in another tab, so this note was removed from this device.";
    }
  });

  /** Saves the note; false if it's too long to save. */
  function save(): boolean {
    timer = 0;
    if (closed) return true;
    const markdown = bodyMarkdown();
    problem.hidden = markdown.length <= MAX_BODY;
    if (markdown.length > MAX_BODY) {
      problem.textContent = `This note is too long to save (${markdown.length.toLocaleString()} of ${MAX_BODY.toLocaleString()} characters). Shorten it to keep your changes.`;
      return false;
    }
    const note = saveNote({ id: noteId, eventId, title: titleInput.value, body: markdown });
    // A new note, or this one was deleted elsewhere and saved as a new note.
    if (note.id !== noteId) {
      noteId = note.id;
      removeButton.hidden = false;
      // Reloading the page edits this note instead of starting another.
      history.replaceState(null, "", `/notes/new/?id=${encodeURIComponent(noteId)}`);
    }
    saved.textContent = notesPersist()
      ? `Saved on this device at ${formatTime(new Date())} · ${words()}`
      : "This browser blocks saving; your note lasts only while this page is open.";
    return true;
  }

  let timer = 0;
  let typed = false;
  function changed() {
    typed = true;
    clearTimeout(timer);
    timer = window.setTimeout(save, 400);
  }
  // The title and the Markdown view; the editor reports its own changes.
  titleInput.addEventListener("input", changed);
  source.addEventListener("input", changed);
  saved.textContent = words();
  // Leaving the page mid-pause still saves the last few keystrokes.
  window.addEventListener("pagehide", () => {
    if (timer) {
      clearTimeout(timer);
      timer = 0;
      save();
    }
  });

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    clearTimeout(timer);
    timer = 0;
    // Done without typing saves nothing: a new note backs out, and an
    // existing one keeps its time (and stays deleted if that happened elsewhere).
    if (!typed) {
      location.href = noteId ? `/notes/view/?id=${encodeURIComponent(noteId)}` : eventId ? `/event/${eventId}/` : "/notes/";
      return;
    }
    // Too long: stay, with the message showing, rather than lose the changes.
    if (!save()) return;
    location.href = `/notes/view/?id=${encodeURIComponent(noteId!)}`;
  });

  removeButton.addEventListener("click", () => {
    if (!noteId || !confirm("Delete this note?")) return;
    clearTimeout(timer);
    timer = 0;
    deleteNote(noteId);
    location.href = "/notes/";
  });
</script>

<style>
  .editor {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  label {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .field-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .mode {
    min-height: var(--tap);
    padding: 0 var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    cursor: pointer;
  }
  .mode[aria-pressed="true"] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }
  /* The toolbar pins under the page header as you scroll a long note; on a
     phone with the keyboard up, it rides just above the keyboard instead. */
  .toolbar-slot {
    position: sticky;
    top: var(--sticky-offset, 0px);
    z-index: 6;
  }
  .toolbar-slot[hidden] {
    display: none;
  }
  /* The slot does the pinning; the toolbar sits at its top (an offset here
     would push it a header's height below the header). */
  .toolbar {
    position: relative;
    z-index: 6;
    background: var(--bg);
  }
  /* Floating above the keyboard, an open panel sits above the buttons. */
  .toolbar[data-floating] {
    position: fixed;
    z-index: 30;
    display: flex;
    flex-direction: column-reverse;
    padding: 0 var(--space-2);
    border-top: 1px solid var(--line);
    background: var(--surface);
  }
  .toolbar[data-floating] .panel {
    border-top: 0;
    border-bottom: 1px solid var(--line);
  }
  .tools {
    display: flex;
    gap: var(--space-1);
    overflow-x: auto;
    padding: var(--space-1) 0;
    scrollbar-width: none;
  }
  .tools :global(.tool) {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  .tools :global(.tool[hidden]) {
    display: none;
  }
  .tools :global(.tool[aria-disabled="true"]) {
    color: var(--muted);
    opacity: 0.5;
    cursor: default;
  }
  .tools :global(.tool[aria-pressed="true"]),
  .tools :global(.tool[aria-expanded="true"]) {
    background: var(--accent);
    color: var(--on-accent);
  }
  .tools :global(.tool:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-height: 50vh;
    overflow-y: auto;
    padding: var(--space-2) 0;
    border-top: 1px solid var(--line);
  }
  .panel[hidden] {
    display: none;
  }
  .panel :global(.panel-title) {
    margin: 0 0 var(--space-1);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .panel :global(.panel-item) {
    min-height: var(--tap);
    padding: var(--space-2) var(--space-3);
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: var(--text-sm);
    text-align: left;
    cursor: pointer;
  }
  .panel :global(.panel-item:hover),
  .panel :global(.panel-item:focus-visible) {
    background: var(--line);
    outline: none;
  }
  .panel :global(.panel-form) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .panel :global(.panel-form input) {
    flex: 1 1 12rem;
  }
  .panel :global(.panel-action) {
    min-height: var(--tap);
    padding: 0 var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .panel :global(.panel-action.primary) {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }
  .panel :global(.panel-preview) {
    max-width: 100%;
    max-height: 30vh;
    object-fit: contain;
    align-self: flex-start;
    border-radius: var(--radius-sm);
  }
  .panel :global(.panel-label) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .panel :global(.panel-note) {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .panel :global(.panel-action[aria-disabled="true"]) {
    opacity: 0.5;
  }
  .panel :global(.panel-results) {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .panel :global(.panel-results .panel-item) {
    width: 100%;
  }
  .panel :global(.panel-results li.muted) {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
  }
  .body-editor[hidden] {
    display: none;
  }
  .body-editor :global(.note-editor-content) {
    min-height: 16rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    outline: none;
  }
  .body-editor :global(.note-editor-content:focus-visible) {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }
  /* The placeholder shows in an empty first paragraph. */
  .body-editor :global(p.is-editor-empty:first-child::before) {
    content: attr(data-placeholder);
    float: left;
    height: 0;
    color: var(--muted);
    pointer-events: none;
  }
  .warn {
    margin: 0;
    color: var(--warn);
    font-weight: 600;
  }
  .warn[hidden] {
    display: none;
  }
  .source {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  input,
  textarea,
  .panel :global(input) {
    width: 100%;
    min-height: var(--tap);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: var(--text-md);
    font-weight: 400;
  }
  textarea {
    resize: vertical;
    line-height: 1.5;
  }
</style>
