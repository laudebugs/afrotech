---
// Saved › Notes (plans 0005, 0007): your notes from this device and, when
// you're signed in, your account. Nothing about them is in the built page.
import "../../styles/notes.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NoteEventLookup from "../../components/NoteEventLookup.astro";
import SavedHead from "../../components/SavedHead.astro";
import Account from "../../components/Account.astro";
---

<BaseLayout title="Notes · Saved · AfroTech 2026 Planner" active="plan">
  <div class="notes-page">
    <header class="page-head sticky-head">
      <SavedHead current="notes">
        <p class="muted small intro">Only you can see your notes. Sign in below to keep them on all your devices.</p>
      </SavedHead>
    </header>
    <ul class="list" data-list></ul>
    <p data-empty hidden>No notes yet. Open any session and tap “Write a note”.</p>
    <div class="buttons new">
      <a class="button" href="/notes/new/">Write a note</a>
    </div>
    <Account />
  </div>
  <NoteEventLookup />
</BaseLayout>

<script>
  import { listNotes } from "../../lib/notes";
  import { noteEvent } from "../../lib/note-events";
  import { formatDate } from "../../lib/time";

  function render() {
    const notes = listNotes();
    const items = notes.map((n) => {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = `/notes/view/?id=${encodeURIComponent(n.id)}`;
      const title = document.createElement("strong");
      title.textContent = n.title.trim() || "Untitled note";
      const meta = document.createElement("span");
      meta.className = "muted";
      const about = noteEvent(n.eventId)?.title;
      meta.textContent = `${formatDate(new Date(n.updatedAt).toISOString())}${about ? ` · ${about}` : ""}`;
      a.append(title, meta);
      li.append(a);
      return li;
    });
    document.querySelector("[data-list]")!.replaceChildren(...items);
    document.querySelector<HTMLElement>("[data-empty]")!.hidden = notes.length > 0;
  }

  document.addEventListener("notes-change", render);
  window.addEventListener("pageshow", (e) => e.persisted && render());
  render();
</script>

<style>
  .intro {
    margin-top: var(--space-2);
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .list :global(a) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }
  .list :global(.muted) {
    font-size: var(--text-sm);
  }
  .new {
    margin-top: var(--space-4);
  }
</style>
