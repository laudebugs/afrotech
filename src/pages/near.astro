---
// Near me: what's live or starting within the hour, closest first. Distances
// use one scale for everything: rooms on the convention center map are turned
// into latitude/longitude through the floor-plan transform, hotels and parks
// use where they really are, and side events their looked-up addresses.
import "../styles/event-rows.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import HereControls from "../components/HereControls.astro";
import SourcesFooter from "../components/SourcesFooter.astro";
import { allEvents, venues } from "../lib/events";
import { areaPlace, floorPlan } from "../lib/floor-plan";
import type { NearEvent, Place } from "../lib/types";
import geocodeJson from "../../data/geocode.json";

const geocode = geocodeJson as Record<string, { found: boolean; lat?: number; lng?: number }>;

const nearEvents: NearEvent[] = [];
for (const e of allEvents) {
  if (!e.start) continue;
  const venue = e.locationKey ? venues[e.locationKey] : undefined;
  const geo = e.address ? geocode[e.address.trim()] : undefined;
  let place: { lat: number | null; lng: number | null; level: number | null } = { lat: null, lng: null, level: null };
  if (venue?.areaId) place = areaPlace(venue.areaId) ?? place;
  else if (geo?.found) place = { lat: geo.lat!, lng: geo.lng!, level: null };
  else if (venue?.level) place.level = venue.level; // e.g. expo areas: Level 1, spot unknown
  nearEvents.push({ id: e.id, title: e.title, start: e.start, end: e.end, place: e.locationLabel, ...place });
}
// Rooms you can pick, as points, so a pick works like a GPS fix.
const areaPlaces: Record<string, Place> = Object.fromEntries(Object.keys(floorPlan.areas).map((id) => [id, areaPlace(id)!]));
const json = JSON.stringify({ nearEvents, areaPlaces }).replace(/</g, "\\u003c");
---

<BaseLayout title="Near me · AfroTech 2026 Planner" active="now">
  <header class="page-head sticky-head">
    <h1>Near me</h1>
    <p class="muted intro">Live now and starting within the hour, closest first.</p>
  </header>

  <HereControls />

  <p class="summary muted" aria-live="polite" data-summary></p>
  <ul class="event-rows" data-near></ul>

  <SourcesFooter />
</BaseLayout>

<script is:inline type="application/json" id="near-data" set:html={json} />

<script>
  import { herePlace } from "../lib/here";
  import { formatDistance, haversineMetres } from "../lib/geo";
  import { eventEndMs, everyMinute, formatRange, previewNow } from "../lib/time";
  import { eventRow } from "../scripts/event-rows";
  import { syncPlan } from "../scripts/plan-ui";
  import type { NearEvent, Place } from "../lib/types";

  const { nearEvents, areaPlaces } = JSON.parse(document.getElementById("near-data")!.textContent!) as {
    nearEvents: NearEvent[];
    areaPlaces: Record<string, Place>;
  };
  const HOUR = 3600_000;
  // A change of level costs about as much as walking 30 m (stairs, escalator).
  const LEVEL_PENALTY_M = 30;
  const events = (n: number) => `${n} ${n === 1 ? "event is" : "events are"}`;

  const list = document.querySelector<HTMLElement>("[data-near]")!;
  const summary = document.querySelector<HTMLElement>("[data-summary]")!;

  function render() {
    const now = previewNow();
    const soon = nearEvents.filter((e) => {
      const start = Date.parse(e.start);
      return (start <= now && now < eventEndMs(e.start, e.end)) || (now < start && start <= now + HOUR);
    });
    const origin = herePlace((id) => areaPlaces[id]);

    const rows = soon
      .map((e) => {
        if (!origin || e.lat === null || e.lng === null) return { e, metres: null as number | null };
        const levelChange = origin.level && e.level ? Math.abs(origin.level - e.level) : 0;
        return { e, metres: haversineMetres(origin, { lat: e.lat, lng: e.lng }) + levelChange * LEVEL_PENALTY_M };
      })
      // Closest first; events with no known place go last, in time order.
      .sort((a, b) => (a.metres ?? Infinity) - (b.metres ?? Infinity) || a.e.start.localeCompare(b.e.start));

    summary.textContent = !soon.length
      ? "Nothing is live or starting within the hour."
      : origin
        ? `${events(soon.length)} live or starting within the hour, closest first.`
        : `${events(soon.length)} live or starting within the hour. Share your location or pick your room to sort them by distance.`;
    list.replaceChildren(
      ...rows.map(({ e, metres }) => {
        const live = Date.parse(e.start) <= now;
        const distance = !origin ? null : metres === null ? "distance unknown" : metres < 15 ? "Here" : formatDistance(metres);
        const where = [distance, e.place, e.level ? `Level ${e.level}` : null].filter(Boolean).join(" · ");
        return eventRow({
          id: e.id,
          title: e.title,
          before: `${formatRange(e.start, e.end)}${live ? " · live" : ""}`,
          after: [where],
          live,
        });
      }),
    );
    syncPlan(list);
  }

  everyMinute(render);
  document.addEventListener("here-change", render);
</script>

<style>
  h1 {
    margin: 0;
    font-size: var(--text-2xl);
  }
  .intro {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
  }
  .page-head + :global(.here) {
    margin-top: var(--space-4);
  }
  .summary {
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
  }
</style>
