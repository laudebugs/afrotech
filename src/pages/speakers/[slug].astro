---
// One speaker: photo, In brief, full bio, links and their sessions.
import BaseLayout from "../../layouts/BaseLayout.astro";
import SpeakerPhoto from "../../components/SpeakerPhoto.astro";
import Timeline from "../../components/Timeline.astro";
import TimelineRow from "../../components/TimelineRow.astro";
import EventCard from "../../components/EventCard.astro";
import SourcesFooter from "../../components/SourcesFooter.astro";
import { sessionsOf, speakers } from "../../lib/speakers";
import { formatClock, formatDate, formatRange } from "../../lib/time";
import type { SpeakerProfile } from "../../lib/types";
import { NOTES_REPO, SITE_URL } from "../../config";

export function getStaticPaths() {
  return speakers.map((speaker) => ({ params: { slug: speaker.slug }, props: { speaker } }));
}

interface Props {
  speaker: SpeakerProfile;
}
const { speaker } = Astro.props;
const sessions = sessionsOf(speaker);
const role = [speaker.title, speaker.company].filter(Boolean).join(" · ");
const paragraphs = speaker.bio?.split("\n\n") ?? [];
const research = speaker.research;
const links = research?.website
  ? [...speaker.links, { kind: "website" as const, label: "Website", url: research.website }]
  : speaker.links;
const kindLabel = { article: "Article", talk: "Talk", podcast: "Podcast" } as const;

// "Is this you?" opens the speaker-change issue form with the profile filled in.
const profileUrl = `${SITE_URL}/speakers/${speaker.slug}/`;
const changeUrl =
  `https://github.com/${NOTES_REPO.owner}/${NOTES_REPO.repo}/issues/new?` +
  new URLSearchParams({ template: "speaker-change.yml", title: `Speaker profile: ${speaker.name}`, speaker: profileUrl });
// The full bio adds nothing when it's no longer than the brief.
const hasMore = Boolean(speaker.bio && speaker.brief && speaker.bio.length > speaker.brief.length + 20);

// schema.org Person, so search engines can tell who this is.
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE_URL}/speakers/${speaker.slug}/#person`,
  name: speaker.name,
  jobTitle: speaker.title ?? undefined,
  worksFor: speaker.company ? { "@type": "Organization", name: speaker.company } : undefined,
  description: speaker.brief ?? undefined,
  image: speaker.photoUrl ?? undefined,
  sameAs: speaker.links.map((l) => l.url),
  url: `${SITE_URL}/speakers/${speaker.slug}/`,
}).replace(/</g, "\\u003c");
---

<BaseLayout title={`${speaker.name} · Speakers · AfroTech 2026 Planner`} active="none" description={speaker.brief ?? undefined}>
  <p class="back"><a href="/speakers/">← Speakers</a></p>

  <header class="profile-head">
    <SpeakerPhoto name={speaker.name} url={speaker.photoUrl} size={96} priority />
    <div>
      <h1>{speaker.name}</h1>
      {role && <p class="muted role">{role}</p>}
    </div>
  </header>

  {
    speaker.brief && (
      <section class="brief" aria-labelledby="brief-title">
        <h2 id="brief-title" class="mono">In brief</h2>
        <p>{speaker.brief}</p>
      </section>
    )
  }

  {
    hasMore && (
      <details class="bio">
        <summary>Read the full bio</summary>
        {paragraphs.map((p) => <p>{p}</p>)}
      </details>
    )
  }

  {
    links.length > 0 && (
      <ul class="links" aria-label="Links">
        {links.map((l) => (
          <li>
            <a class="button" href={l.url} rel="noopener noreferrer">{l.label}</a>
          </li>
        ))}
      </ul>
    )
  }

  {
    research && (research.facts.length > 0 || research.articles.length > 0) && (
      <section class="research" aria-labelledby="research-title">
        <h2 id="research-title" class="mono">Community-compiled</h2>
        <p class="muted note">
          Gathered from public sources by the planner's editors, not supplied by the speaker. Each line links
          to its source{research.checkedAt && <>; checked {research.checkedAt}</>}.
        </p>
        {research.facts.length > 0 && (
          <>
            <h3>Fun facts</h3>
            <ul class="facts">
              {research.facts.map((f) => (
                <li>
                  {f.text}{" "}
                  <a href={f.url} rel="noopener noreferrer">{f.publisher ?? "Source"}</a>
                </li>
              ))}
            </ul>
          </>
        )}
        {research.articles.length > 0 && (
          <>
            <h3>Articles and talks</h3>
            <ul class="articles">
              {research.articles.map((a) => (
                <li>
                  <a href={a.url} rel="noopener noreferrer">{a.title}</a>
                  <span class="muted">
                    {[a.kind ? kindLabel[a.kind] : null, a.publisher, a.date].filter(Boolean).join(" · ")}
                  </span>
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    )
  }

  {
    sessions.length > 0 && (
      <section aria-labelledby="sessions-title">
        <h2 id="sessions-title" class="mono">Sessions</h2>
        <Timeline label={`Sessions with ${speaker.name}`}>
          {sessions.map((event) => (
            <>
              {/* No hour headers here, so the day line carries AM/PM. */}
              <p class="day mono">
                {event.start ? `${formatDate(event.start)} · ${formatRange(event.start, event.end)}` : event.date}
              </p>
              <TimelineRow
                time={event.start ? formatClock(event.start) : (event.timeLabel ?? "TBA")}
                datetime={event.start ?? undefined}
                data-row
                data-event-id={event.id}
                data-start={event.start ?? undefined}
                data-end={event.end ?? undefined}
              >
                <EventCard event={event} />
              </TimelineRow>
            </>
          ))}
        </Timeline>
      </section>
    )
  }

  <aside class="credit">
    <p class="muted">
      Bio, photo and links from the official AfroTech 2026 schedule. <a href="/speakers/about/">How profiles are made</a>.
    </p>
    <p>
      <strong>Is this you?</strong> <a href={changeUrl} rel="noopener">Ask for a change or removal</a>. We act within
      48 hours.
    </p>
  </aside>
  <SourcesFooter />
</BaseLayout>

<script is:inline type="application/ld+json" set:html={jsonLd} />

<style>
  .back {
    margin: var(--space-6) 0 var(--space-4);
  }
  .back a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 600;
    text-decoration: none;
  }
  .profile-head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  h1 {
    margin: 0;
    font-size: var(--text-2xl);
  }
  .role {
    margin: var(--space-1) 0 0;
  }
  h2 {
    margin: var(--space-6) 0 var(--space-2);
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .brief p {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.4;
  }
  .bio {
    margin-top: var(--space-4);
  }
  .bio summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--accent);
    font-weight: 600;
    cursor: pointer;
  }
  .bio p {
    overflow-wrap: anywhere;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .button {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .research {
    margin-top: var(--space-2);
  }
  .research .note {
    margin: 0;
    font-size: var(--text-xs);
  }
  .research h3 {
    margin: var(--space-4) 0 var(--space-2);
    font-size: var(--text-md);
  }
  .facts,
  .articles {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding-left: var(--space-4);
  }
  .facts a,
  .articles .muted {
    font-size: var(--text-sm);
  }
  .articles li {
    display: flex;
    flex-direction: column;
  }
  .day {
    margin: var(--space-2) 0 0 calc(var(--rail-time) + var(--rail-dot) + var(--space-2));
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .credit p {
    margin: 0 0 var(--space-1);
  }
  .credit {
    margin-top: var(--space-8);
    font-size: var(--text-xs);
  }
</style>
