---
// The convention center map: three levels, rooms coloured by what's on today,
// tap a room for its sessions. A plain "Live now" list below covers the same
// ground for keyboard and screen-reader users, and for places not on the map.
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomSheet from "../../components/BottomSheet.astro";
import SourcesFooter from "../../components/SourcesFooter.astro";
import { allEvents, venues } from "../../lib/events";
import { floorPlan } from "../../lib/floor-plan";
import level1 from "../../assets/maps/grb-level-1.svg?raw";
import level2 from "../../assets/maps/grb-level-2.svg?raw";
import level3 from "../../assets/maps/grb-level-3.svg?raw";

const svgs: Record<string, string> = { "1": level1, "2": level2, "3": level3 };
const levels = Object.entries(floorPlan.levels).map(([n, l]) => ({ n, title: l.title }));

type MapEvent = { id: string; title: string; start: string; end: string | null; date: string; place: string };
const slim = (e: (typeof allEvents)[number]): MapEvent => ({
  id: e.id,
  title: e.title,
  start: e.start!,
  end: e.end,
  date: e.date,
  place: e.locationLabel,
});

// Timed events by map area, and by off-map place (expo areas, lounges).
const byArea: Record<string, MapEvent[]> = {};
const offMap: Record<string, { label: string; note: string; events: MapEvent[] }> = {};
for (const e of allEvents) {
  const venue = e.locationKey ? venues[e.locationKey] : undefined;
  if (!venue || !e.start) continue;
  if (venue.areaId) (byArea[venue.areaId] ??= []).push(slim(e));
  else if (venue.note && venue.kind !== "offsite") {
    (offMap[e.locationKey!] ??= { label: venue.label, note: venue.note, events: [] }).events.push(slim(e));
  }
}
// Venues whose spot inside their area is unknown (e.g. HealthStack rooms in the Marriott).
const approxPlaces = Object.values(venues)
  .filter((v) => v.areaId && v.approximate)
  .map((v) => ({ areaId: v.areaId!, label: v.label }));

const mapData = { areas: floorPlan.areas, byArea, offMap, approxPlaces };
// Safe inside <script type="application/json">: "<" can't start a closing tag.
const json = JSON.stringify(mapData).replace(/</g, "\\u003c");
---

<BaseLayout title="Map · AfroTech 2026 Planner" active="map">
  <header class="page-head sticky-head">
    <div class="title-row">
      <h1>Map</h1>
      <span class="muted" data-map-day></span>
    </div>
    <div class="levels" role="group" aria-label="Level">
      {
        levels.map((l) => (
          <button type="button" class="chip" data-level-button={l.n} aria-pressed={l.n === "1" ? "true" : "false"}>
            Level {l.n}<span class="count" data-level-live={l.n}></span>
          </button>
        ))
      }
    </div>
  </header>

  <section class="map" aria-label="Convention center map">
    <div class="viewport" data-viewport>
      <div class="stage" data-stage>
        {
          levels.map((l) => (
            <div class="level" data-level={l.n} hidden={l.n !== "1"}>
              <Fragment set:html={svgs[l.n]} />
            </div>
          ))
        }
      </div>
    </div>
    <div class="zoom" role="group" aria-label="Zoom">
      <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
      <button type="button" data-zoom="out" aria-label="Zoom out">−</button>
      <button type="button" data-zoom="reset" aria-label="Fit the whole level">⤢</button>
    </div>
    <p class="legend muted">
      <span class="key live"></span> live now
      <span class="key plan"></span> in my plan
      <span class="key dashed"></span> approximate
    </p>
  </section>

  <section class="live-list" aria-labelledby="live-title">
    <h2 id="live-title">Live now</h2>
    <ul data-live-list></ul>
    <p class="muted" data-live-empty hidden>Nothing is on right now.</p>
  </section>

  <BottomSheet id="area-sheet" label="Room details">
    <div data-area-body></div>
  </BottomSheet>

  <SourcesFooter />
</BaseLayout>

<script is:inline type="application/json" id="map-data" set:html={json} />

<script>
  import Panzoom from "@panzoom/panzoom";
  import { readPlan } from "../../lib/plan";
  import { dayKey, formatDate, formatRange } from "../../lib/time";
  import type { MapArea } from "../../lib/types";

  type MapEvent = { id: string; title: string; start: string; end: string | null; date: string; place: string };
  type MapData = {
    areas: Record<string, MapArea>;
    byArea: Record<string, MapEvent[]>;
    offMap: Record<string, { label: string; note: string; events: MapEvent[] }>;
    approxPlaces: { areaId: string; label: string }[];
  };
  const data: MapData = JSON.parse(document.getElementById("map-data")!.textContent!);
  const HOUR = 3600_000;

  // ?now=2026-11-04T11:00 previews any Houston moment, as on the Now page.
  function now(): number {
    const forced = new URLSearchParams(location.search).get("now");
    const t = forced ? Date.parse(forced.length === 16 ? `${forced}:00-06:00` : forced) : NaN;
    return Number.isNaN(t) ? Date.now() : t;
  }
  const endOf = (e: MapEvent) => (e.end ? Date.parse(e.end) : Date.parse(e.start) + HOUR);
  const isLive = (e: MapEvent, t: number) => Date.parse(e.start) <= t && t < endOf(e);

  // --- Pan and zoom -------------------------------------------------------
  const viewport = document.querySelector<HTMLElement>("[data-viewport]")!;
  const stage = document.querySelector<HTMLElement>("[data-stage]")!;
  // No "contain": rooms near an edge must be able to reach the middle; ⤢ resets.
  const panzoom = Panzoom(stage, { maxScale: 6, minScale: 0.8, step: 0.4 });
  viewport.addEventListener("wheel", (e) => panzoom.zoomWithWheel(e));
  document.querySelectorAll<HTMLButtonElement>("[data-zoom]").forEach((b) =>
    b.addEventListener("click", () => {
      if (b.dataset.zoom === "in") panzoom.zoomIn();
      else if (b.dataset.zoom === "out") panzoom.zoomOut();
      else panzoom.reset();
    }),
  );

  // --- Levels -------------------------------------------------------------
  function showLevel(n: string) {
    document.querySelectorAll<HTMLElement>("[data-level]").forEach((l) => (l.hidden = l.dataset.level !== n));
    document.querySelectorAll<HTMLButtonElement>("[data-level-button]").forEach((b) =>
      b.setAttribute("aria-pressed", String(b.dataset.levelButton === n)),
    );
    panzoom.reset({ animate: false });
  }
  document.querySelectorAll<HTMLButtonElement>("[data-level-button]").forEach((b) =>
    b.addEventListener("click", () => showLevel(b.dataset.levelButton!)),
  );

  // --- Room states --------------------------------------------------------
  const svgNS = "http://www.w3.org/2000/svg";
  function render() {
    const t = now();
    const today = dayKey(new Date(t));
    const planned = new Set(readPlan());
    document.querySelector("[data-map-day]")!.textContent = formatDate(new Date(t));
    const liveByLevel: Record<string, number> = {};

    document.querySelectorAll<SVGGElement>("g.area").forEach((g) => {
      const id = g.dataset.area!;
      const area = data.areas[id];
      const events = (data.byArea[id] ?? []).filter((e) => e.date === today);
      const live = events.filter((e) => isLive(e, t)).length;
      const mine = events.some((e) => planned.has(e.id));
      g.toggleAttribute("data-quiet", events.length === 0);
      g.toggleAttribute("data-live", live > 0);
      g.toggleAttribute("data-in-plan", mine);
      if (live) liveByLevel[area.level] = (liveByLevel[area.level] ?? 0) + live;
      const parts = [area.label, live ? `${live} live now` : null, events.length ? `${events.length} today` : "nothing today"];
      g.setAttribute("aria-label", parts.filter(Boolean).join(", "));

      // A count badge, so "live" never relies on colour alone.
      g.querySelector(".badge")?.remove();
      if (live) {
        const rect = g.querySelector("rect")!;
        const badge = document.createElementNS(svgNS, "text");
        badge.setAttribute("class", "badge");
        badge.setAttribute("x", String(Number(rect.getAttribute("x")) + 6));
        badge.setAttribute("y", String(Number(rect.getAttribute("y")) + 18));
        badge.setAttribute("aria-hidden", "true");
        badge.textContent = `● ${live} live`;
        g.append(badge);
      }
    });

    document.querySelectorAll<HTMLElement>("[data-level-live]").forEach((c) => {
      const n = liveByLevel[c.dataset.levelLive!];
      c.textContent = n ? ` · ${n} live` : "";
    });
    renderLiveList(t, today);
  }

  // --- The "Live now" list (also the keyboard and screen-reader path) -----
  function renderLiveList(t: number, today: string) {
    const list = document.querySelector<HTMLElement>("[data-live-list]")!;
    const items: HTMLLIElement[] = [];
    for (const [id, events] of Object.entries(data.byArea)) {
      const live = events.filter((e) => e.date === today && isLive(e, t));
      if (!live.length) continue;
      const area = data.areas[id];
      const li = document.createElement("li");
      const button = document.createElement("button");
      button.type = "button";
      button.className = "place";
      button.dataset.openArea = id;
      button.innerHTML = `<strong></strong><span class="muted"></span>`;
      button.querySelector("strong")!.textContent = area.label;
      button.querySelector("span")!.textContent = ` · Level ${area.level} · ${live.length} live: ${live.map((e) => e.title).join("; ")}`;
      li.append(button);
      items.push(li);
    }
    for (const place of Object.values(data.offMap)) {
      const live = place.events.filter((e) => e.date === today && isLive(e, t));
      if (!live.length) continue;
      const li = document.createElement("li");
      li.className = "off-map";
      const head = document.createElement("p");
      head.innerHTML = "<strong></strong> <span class='muted'></span>";
      head.querySelector("strong")!.textContent = place.label;
      head.querySelector("span")!.textContent = place.note;
      const links = document.createElement("p");
      live.forEach((e, i) => {
        const a = document.createElement("a");
        a.href = `/event/${e.id}/`;
        a.textContent = e.title;
        if (i) links.append("; ");
        links.append(a);
      });
      li.append(head, links);
      items.push(li);
    }
    list.replaceChildren(...items);
    document.querySelector<HTMLElement>("[data-live-empty]")!.hidden = items.length > 0;
  }

  // --- Room sheet ---------------------------------------------------------
  const sheet = document.querySelector<HTMLDialogElement>("#area-sheet")!;
  const body = sheet.querySelector<HTMLElement>("[data-area-body]")!;
  const starIcon =
    '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.1 8.3 22 9.3 17 14.1 18.2 21 12 17.8 5.8 21 7 14.1 2 9.3 8.9 8.3"/></svg>';

  function openArea(id: string) {
    const area = data.areas[id];
    if (!area) return;
    const t = now();
    const today = dayKey(new Date(t));
    const all = (data.byArea[id] ?? []).slice().sort((a, b) => a.start.localeCompare(b.start));
    // Today's sessions; on a quiet day, the next day this room has any.
    const nextDay = all.find((e) => e.date >= today)?.date;
    const shown = all.filter((e) => e.date === (all.some((e) => e.date === today) ? today : nextDay));

    document.querySelectorAll("g.area[data-selected]").forEach((g) => g.removeAttribute("data-selected"));
    document.getElementById(`area-${id}`)?.setAttribute("data-selected", "");

    const frag = document.createElement("div");
    frag.className = "area-sheet";
    const h = document.createElement("h2");
    // Rooms are labelled "320" on the map; say "Meeting Room 320" here.
    h.textContent = /^\d+$/.test(area.label) ? `Meeting Room ${area.label}` : area.label;
    const sub = document.createElement("p");
    sub.className = "muted";
    const day = shown[0] ? formatDate(shown[0].start) : null;
    sub.textContent = `Level ${area.level}${day ? ` · ${day}` : ""}`;
    frag.append(h, sub);

    const notes = [
      area.approximate ? "Its position on the map is approximate." : null,
      ...data.approxPlaces.filter((p) => p.areaId === id).map((p) => `${p.label}: the exact room isn't published.`),
    ].filter(Boolean) as string[];
    for (const n of notes) {
      const p = document.createElement("p");
      p.className = "muted note";
      p.textContent = n;
      frag.append(p);
    }

    if (!shown.length) {
      const p = document.createElement("p");
      p.textContent = "No sessions listed here for the rest of the week.";
      frag.append(p);
    } else {
      const ul = document.createElement("ul");
      ul.className = "sessions";
      for (const e of shown) {
        const li = document.createElement("li");
        if (isLive(e, t)) li.dataset.live = "";
        const text = document.createElement("div");
        const time = document.createElement("p");
        time.className = "muted";
        time.textContent = `${formatRange(e.start, e.end)}${isLive(e, t) ? " · live" : ""}${e.place !== area.label ? ` · ${e.place}` : ""}`;
        const a = document.createElement("a");
        a.href = `/event/${e.id}/`;
        a.textContent = e.title;
        text.append(time, a);
        const star = document.createElement("button");
        star.type = "button";
        star.className = "star";
        star.dataset.star = e.id;
        star.dataset.title = e.title;
        star.setAttribute("aria-label", `My plan: ${e.title}`);
        star.setAttribute("aria-pressed", "false");
        star.innerHTML = starIcon;
        li.append(text, star);
        ul.append(li);
      }
      frag.append(ul);
    }
    body.replaceChildren(frag);
    if (!sheet.open) sheet.showModal();
  }
  sheet.addEventListener("close", () =>
    document.querySelectorAll("g.area[data-selected]").forEach((g) => g.removeAttribute("data-selected")),
  );

  /** Shows the area's level and centres it, zoomed in. Panzoom scales around
   *  the stage's centre (w/2, h/2), then translates by (tx, ty) unscaled pixels,
   *  so a point p lands at centre + scale·(p − centre + t). This solves for the t
   *  that puts the room in the middle, and applies it as Panzoom's start view. */
  function focusArea(id: string) {
    const area = data.areas[id];
    const g = document.getElementById(`area-${id}`) as SVGGElement | null;
    if (!area || !g) return;
    showLevel(String(area.level));
    const svg = g.ownerSVGElement!;
    const box = g.querySelector("rect")!.getBBox();
    const vb = svg.viewBox.baseVal;
    const k = svg.clientWidth / vb.width; // px per map foot at scale 1
    const cx = (box.x + box.width / 2 - vb.x) * k;
    const cy = (box.y + box.height / 2 - vb.y) * k;
    const scale = Math.min(3, Math.max(1.5, (viewport.clientWidth * 0.6) / (box.width * k)));
    const w = stage.clientWidth;
    const h = stage.clientHeight;
    const startX = (viewport.clientWidth / 2 - w / 2) / scale + w / 2 - cx;
    const startY = (viewport.clientHeight / 2 - h / 2) / scale + h / 2 - cy;
    panzoom.setOptions({ startScale: scale, startX, startY });
    panzoom.reset({ animate: false });
    // ⤢ and level changes should still show the whole level.
    panzoom.setOptions({ startScale: 1, startX: 0, startY: 0 });
  }

  // Taps on rooms: ignore the end of a drag, so panning never opens a sheet.
  let down: { x: number; y: number } | null = null;
  stage.addEventListener("pointerdown", (e) => (down = { x: e.clientX, y: e.clientY }));
  stage.addEventListener("click", (e) => {
    const g = (e.target as Element).closest<SVGGElement>("g.area");
    const moved = down ? Math.hypot(e.clientX - down.x, e.clientY - down.y) : 0;
    if (g && moved < 8) openArea(g.dataset.area!);
  });
  stage.addEventListener("keydown", (e) => {
    const g = (e.target as Element).closest<SVGGElement>("g.area");
    if (g && (e.key === "Enter" || e.key === " ")) {
      e.preventDefault();
      openArea(g.dataset.area!);
    }
  });
  document.querySelector("[data-live-list]")!.addEventListener("click", (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>("[data-open-area]");
    if (!b) return;
    focusArea(b.dataset.openArea!);
    openArea(b.dataset.openArea!);
  });

  // --- Start --------------------------------------------------------------
  render();
  document.addEventListener("plan-change", () => render());
  document.addEventListener("visibilitychange", () => document.visibilityState === "visible" && render());
  window.addEventListener("pageshow", (e) => e.persisted && render());
  setInterval(render, 60_000);

  // /map/?area=room-310 (from "Show on map") opens at that room.
  const params = new URLSearchParams(location.search);
  const start = params.get("area");
  if (start && data.areas[start]) {
    // Panzoom queues a setTimeout at setup that pans to its start position;
    // queue after it, or that pan would undo this one.
    setTimeout(() => {
      focusArea(start);
      openArea(start);
    });
  } else if (params.get("level") && floorLevel(params.get("level")!)) {
    showLevel(params.get("level")!);
  }
  function floorLevel(n: string) {
    return Boolean(document.querySelector(`[data-level="${n}"]`));
  }
</script>

<style>
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }
  h1 {
    margin: 0;
    font-size: var(--text-2xl);
  }
  .levels {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .chip[aria-pressed="true"] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }
  .map {
    position: relative;
    margin-top: var(--space-3);
  }
  .viewport {
    height: min(70vh, 640px);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg);
    touch-action: none;
  }
  .zoom {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .zoom button {
    width: var(--tap);
    height: var(--tap);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--text-lg);
    cursor: pointer;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    margin: var(--space-2) 0 0;
    font-size: var(--text-xs);
  }
  .key {
    display: inline-block;
    width: 14px;
    height: 10px;
    border: 2px solid var(--muted);
    border-radius: 2px;
  }
  .key.live {
    border-color: var(--live);
  }
  .key.plan {
    border-color: var(--accent);
  }
  .key.dashed {
    border-style: dashed;
  }
  .live-list h2 {
    margin: var(--space-6) 0 var(--space-2);
    font-size: var(--text-lg);
  }
  .live-list ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .live-list :global(.place) {
    width: 100%;
    min-height: var(--tap);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: var(--text-sm);
    text-align: left;
    cursor: pointer;
  }
  .live-list :global(.off-map) {
    padding: var(--space-2) var(--space-3);
    border: 1px dashed var(--line);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
  }
  .live-list :global(.off-map p) {
    margin: 0;
  }
</style>

<style is:global>
  /* The inline SVGs aren't scoped, so their styles live here, under .stage. */
  .stage .level svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
  }
  .stage .base-outline {
    fill: var(--surface);
    stroke: var(--ink);
    stroke-width: 3;
  }
  .stage .base-dock,
  .stage .base-below,
  .stage .base-bridge {
    fill: var(--line);
  }
  .stage .label {
    fill: var(--muted);
  }
  .stage .area {
    cursor: pointer;
    outline: none;
  }
  .stage .area rect {
    stroke: var(--muted);
    stroke-width: 1.5;
    transition: stroke var(--ease);
  }
  .stage .area--hall rect {
    fill: var(--area-expo);
  }
  .stage .area--stage rect {
    fill: var(--area-stage);
  }
  .stage .area--room rect,
  .stage .area--balcony rect,
  .stage .area--hotel rect {
    fill: var(--area-room);
  }
  .stage .area--lobby rect {
    fill: var(--area-lounge);
  }
  .stage .area--corridor rect {
    fill: var(--surface);
  }
  .stage .area--outside rect {
    fill: var(--area-outside);
  }
  .stage .area-label {
    fill: var(--ink);
    pointer-events: none;
  }
  .stage .area[data-quiet] .area-label {
    fill: var(--muted);
  }
  .stage .area[data-approximate] rect {
    stroke-dasharray: 8 6;
  }
  .stage .area[data-in-plan] rect {
    stroke: var(--accent);
    stroke-width: 5;
  }
  .stage .area[data-live] rect {
    stroke: var(--live);
    stroke-width: 6;
  }
  .stage .area[data-selected] rect,
  .stage .area:focus-visible rect {
    stroke: var(--accent);
    stroke-width: 8;
  }
  .stage .badge {
    fill: var(--live);
    font-size: 16px;
    font-family: var(--font-mono);
    font-weight: 600;
    pointer-events: none;
  }

  /* The room sheet. */
  .area-sheet h2 {
    margin: 0;
    font-size: var(--text-xl);
  }
  .area-sheet .note {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
  }
  .area-sheet .sessions {
    display: flex;
    flex-direction: column;
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .area-sheet .sessions li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
  }
  .area-sheet .sessions li[data-live] {
    border-left: 3px solid var(--live);
    padding-left: var(--space-2);
  }
  .area-sheet .sessions p {
    margin: 0;
    font-size: var(--text-sm);
  }
  .area-sheet .sessions a {
