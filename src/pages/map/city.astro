---
// Side events on a map of Houston. Pins come from data/geocode.json
// (scripts/geocode.py); events without a usable address are listed below.
import BaseLayout from "../../layouts/BaseLayout.astro";
import BottomSheet from "../../components/BottomSheet.astro";
import MapSwitch from "../../components/MapSwitch.astro";
import SourcesFooter from "../../components/SourcesFooter.astro";
import { sideEvents } from "../../lib/events";
import { scheduleDays } from "../../lib/schedule";
import { formatDate } from "../../lib/time";
import geocodeJson from "../../../data/geocode.json";

type Geo = { found: boolean; lat?: number; lng?: number };
const geocode = geocodeJson as Record<string, Geo>;

type CityEvent = { id: string; title: string; start: string | null; end: string | null; date: string; venue: string; host: string | null };
const toCity = (e: (typeof sideEvents)[number]): CityEvent => ({
  id: e.id,
  title: e.title,
  start: e.start,
  end: e.end,
  date: e.date,
  venue: e.locationLabel,
  host: e.host,
});

// One pin per place: events at the same coordinates share it.
const pins: Record<string, { lat: number; lng: number; venue: string; address: string; events: CityEvent[] }> = {};
const unpinned: (CityEvent & { address: string | null })[] = [];
for (const e of sideEvents) {
  const geo = e.address ? geocode[e.address.trim()] : undefined;
  if (geo?.found && geo.lat !== undefined && geo.lng !== undefined) {
    const key = `${geo.lat},${geo.lng}`;
    (pins[key] ??= { lat: geo.lat, lng: geo.lng, venue: e.locationLabel, address: e.address!, events: [] }).events.push(toCity(e));
  } else {
    unpinned.push({ ...toCity(e), address: e.address });
  }
}
const cityData = { pins: Object.values(pins), unpinned };
const json = JSON.stringify(cityData).replace(/</g, "\\u003c");
const dayLabel = (d: string) => formatDate(`${d}T12:00:00-06:00`);
---

<BaseLayout title="City map · AfroTech 2026 Planner" active="map">
  <header class="page-head sticky-head">
    <div class="title-row">
      <h1>Side events</h1>
      <MapSwitch current="city" />
    </div>
    <div class="chips" role="group" aria-label="Show">
      <button type="button" class="chip" data-day="all" aria-pressed="false">All week</button>
      {
        scheduleDays.map((d) => (
          <button type="button" class="chip" data-day={d} aria-pressed="false">
            {dayLabel(d).replace(/,.*?(\d+)$/, " $1")}
          </button>
        ))
      }
      <button type="button" class="chip" data-plan-only aria-pressed="false">My plan</button>
    </div>
  </header>

  <section class="map" aria-label="Map of side events in Houston">
    <div class="city-map" data-city-map></div>
    <p class="status muted" aria-live="polite" data-status></p>
  </section>

  <section class="unpinned" aria-labelledby="unpinned-title">
    <h2 id="unpinned-title">Not on the map</h2>
    <p class="muted">These events have no usable address yet ("shared on approval", TBA) or one the map couldn't place.</p>
    <ul data-unpinned></ul>
  </section>

  <BottomSheet id="venue-sheet" label="Events here">
    <div data-venue-body></div>
  </BottomSheet>

  <SourcesFooter />
</BaseLayout>

<script is:inline type="application/json" id="city-data" set:html={json} />

<script>
  import {
    MapLibreMap,
    Marker,
    NavigationControl,
    Popup,
    setWorkerUrl,
    type GeoJSONSource,
    type MapLayerMouseEvent,
  } from "maplibre-gl";
  // MapLibre does its tile work in a module worker; Vite bundles it with its
  // shared code and hands back the URL.
  import workerUrl from "maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url";
  import "maplibre-gl/dist/maplibre-gl.css";
  import { readPlan } from "../../lib/plan";
  import { syncPlan } from "../../scripts/plan-ui";
  import { dayKey, formatDate, formatRange, previewNow } from "../../lib/time";

  type CityEvent = { id: string; title: string; start: string | null; end: string | null; date: string; venue: string; host: string | null };
  type Pin = { lat: number; lng: number; venue: string; address: string; events: CityEvent[] };
  const data: { pins: Pin[]; unpinned: (CityEvent & { address: string | null })[] } = JSON.parse(
    document.getElementById("city-data")!.textContent!,
  );

  type PinFeature = {
    type: "Feature";
    id: number;
    geometry: { type: "Point"; coordinates: [number, number] };
    properties: { pin: number; count: number; mine: 0 | 1 };
  };
  type Pins = { type: "FeatureCollection"; features: PinFeature[] };

  // The convention center, for orientation.
  const GRB: [number, number] = [-95.3576, 29.7522];

  // --- Filters: a day (or the whole week) and "My plan" -------------------
  const dayButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-day]")];
  const planButton = document.querySelector<HTMLButtonElement>("[data-plan-only]")!;
  const days = dayButtons.map((b) => b.dataset.day!).filter((d) => d !== "all");
  const params = new URLSearchParams(location.search);
  const today = dayKey(new Date(previewNow()));
  let day = params.get("day") ?? (days.includes(today) ? today : "all");
  let planOnly = params.get("plan") === "1";

  function keep(e: CityEvent): boolean {
    return (day === "all" || e.date === day) && (!planOnly || readPlan().includes(e.id));
  }
  function saveFilters() {
    const p = new URLSearchParams(location.search);
    p.set("day", day);
    if (planOnly) p.set("plan", "1");
    else p.delete("plan");
    history.replaceState(null, "", `${location.pathname}?${p}`);
  }

  // --- Map ----------------------------------------------------------------
  // MapLibre needs colour strings, so read them from the design tokens.
  const css = getComputedStyle(document.documentElement);
  const token = (name: string) => css.getPropertyValue(name).trim();
  const dark = css.colorScheme.includes("dark");
  setWorkerUrl(workerUrl);
  const map = new MapLibreMap({
    container: document.querySelector<HTMLElement>("[data-city-map]")!,
    style: `https://tiles.openfreemap.org/styles/${dark ? "dark" : "positron"}`,
    center: GRB,
    zoom: 11.5,
    attributionControl: { compact: true },
    cooperativeGestures: true, // one finger scrolls the page; two fingers move the map
  });
  map.addControl(new NavigationControl({ showCompass: false }), "top-right");

  function geojson(): Pins {
    const planned = new Set(readPlan());
    return {
      type: "FeatureCollection",
      features: data.pins.flatMap((pin, i): PinFeature[] => {
        const events = pin.events.filter(keep);
        if (!events.length) return [];
        return [
          {
            type: "Feature",
            id: i,
            geometry: { type: "Point", coordinates: [pin.lng, pin.lat] },
            properties: { pin: i, count: events.length, mine: events.some((e) => planned.has(e.id)) ? 1 : 0 },
          },
        ];
      }),
    };
  }

  map.on("load", () => {
    map.addSource("events", { type: "geojson", data: geojson(), cluster: true, clusterRadius: 40, clusterMaxZoom: 14 });
    map.addLayer({
      id: "clusters",
      type: "circle",
      source: "events",
      filter: ["has", "point_count"],
      paint: { "circle-color": token("--accent"), "circle-radius": 18, "circle-stroke-color": token("--surface"), "circle-stroke-width": 2 },
    });
    map.addLayer({
      id: "cluster-count",
      type: "symbol",
      source: "events",
      filter: ["has", "point_count"],
      layout: { "text-field": ["get", "point_count_abbreviated"], "text-size": 13, "text-font": ["Noto Sans Bold"] },
      paint: { "text-color": token("--on-accent") },
    });
    map.addLayer({
      id: "pins",
      type: "circle",
      source: "events",
      filter: ["!", ["has", "point_count"]],
      paint: {
        // Venues with your picks are plum; others are outlined, so the
        // difference isn't colour alone.
        "circle-color": ["case", ["==", ["get", "mine"], 1], token("--accent"), token("--surface")],
        "circle-stroke-color": token("--accent"),
        "circle-stroke-width": 3,
        "circle-radius": 10,
      },
    });
    new Marker({ color: token("--ink"), scale: 0.8 })
      .setLngLat(GRB)
      .setPopup(new Popup({ offset: 24 }).setText("George R. Brown Convention Center"))
      .addTo(map);

    map.on("click", "clusters", (e: MapLayerMouseEvent) => {
      const feature = e.features![0]!;
      const source = map.getSource("events") as GeoJSONSource;
      const center = (feature.geometry as unknown as { coordinates: [number, number] }).coordinates;
      source
        .getClusterExpansionZoom(feature.properties!.cluster_id as number)
        .then((zoom: number) => map.easeTo({ center, zoom }));
    });
    map.on("click", "pins", (e: MapLayerMouseEvent) => openPin(e.features![0]!.properties!.pin as number));
    for (const layer of ["clusters", "pins"]) {
      map.on("mouseenter", layer, () => (map.getCanvas().style.cursor = "pointer"));
      map.on("mouseleave", layer, () => (map.getCanvas().style.cursor = ""));
    }
    refresh();
  });

  // --- Venue sheet --------------------------------------------------------
  const sheet = document.querySelector<HTMLDialogElement>("#venue-sheet")!;
  const body = sheet.querySelector<HTMLElement>("[data-venue-body]")!;
  const starIcon =
    '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.1 8.3 22 9.3 17 14.1 18.2 21 12 17.8 5.8 21 7 14.1 2 9.3 8.9 8.3"/></svg>';

  function eventRow(e: CityEvent): HTMLLIElement {
    const li = document.createElement("li");
    const text = document.createElement("div");
    const time = document.createElement("p");
    time.className = "muted";
    time.textContent = `${formatDate(e.start ?? `${e.date}T12:00:00-06:00`)} · ${e.start ? formatRange(e.start, e.end) : "Time TBA"}`;
    const a = document.createElement("a");
    a.href = `/event/${e.id}/`;
    a.textContent = e.title;
    text.append(time, a);
    if (e.host) {
      const host = document.createElement("p");
      host.className = "muted";
      host.textContent = e.host;
      text.append(host);
    }
    const star = document.createElement("button");
    star.type = "button";
    star.className = "star";
    star.dataset.star = e.id;
    star.dataset.title = e.title;
    star.setAttribute("aria-label", `My plan: ${e.title}`);
    star.innerHTML = starIcon;
    li.append(text, star);
    return li;
  }

  function openPin(index: number) {
    const pin = data.pins[index];
    if (!pin) return;
    const events = pin.events.filter(keep).sort((a, b) => (a.start ?? "").localeCompare(b.start ?? ""));
    const wrap = document.createElement("div");
    wrap.className = "venue-sheet";
    const h = document.createElement("h2");
    h.textContent = pin.venue;
    const address = document.createElement("p");
    address.className = "muted";
    address.textContent = pin.address;
    const ul = document.createElement("ul");
    ul.className = "sessions";
    ul.append(...events.map(eventRow));
    const directions = document.createElement("a");
    directions.className = "button";
    directions.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(pin.address)}`;
    directions.rel = "noopener";
    directions.textContent = "Directions";
    wrap.append(h, address, directions, ul);
    body.replaceChildren(wrap);
    syncPlan(body);
    if (!sheet.open) sheet.showModal();
  }

  // --- Refresh pins, the list below and the status line --------------------
  function refresh() {
    dayButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.day === day)));
    planButton.setAttribute("aria-pressed", String(planOnly));
    const source = map.getSource("events") as GeoJSONSource | undefined;
    const features = geojson();
    source?.setData(features as unknown as Parameters<GeoJSONSource["setData"]>[0]);

    const shown = features.features.reduce((n: number, f: PinFeature) => n + f.properties.count, 0);
    const where = day === "all" ? "this week" : formatDate(`${day}T12:00:00-06:00`);
    document.querySelector("[data-status]")!.textContent =
      `${shown} side ${shown === 1 ? "event" : "events"} on the map ${planOnly ? "in your plan " : ""}${where}.`;

    const list = document.querySelector<HTMLElement>("[data-unpinned]")!;
    const rows = data.unpinned.filter(keep).sort((a, b) => (a.start ?? a.date).localeCompare(b.start ?? b.date));
    list.replaceChildren(
      ...rows.map((e) => {
        const li = eventRow(e);
        const where = document.createElement("p");
        where.className = "muted";
        where.textContent = [e.venue, e.address].filter((x, i, all) => x && all.indexOf(x) === i).join(" · ") || "Place TBA";
        li.querySelector("div")!.append(where);
        return li;
      }),
    );
    if (!rows.length) {
      const li = document.createElement("li");
      li.className = "muted";
      li.textContent = "None for this filter.";
      list.append(li);
    }
    syncPlan(list);
  }

  dayButtons.forEach((b) =>
    b.addEventListener("click", () => {
      day = b.dataset.day!;
      saveFilters();
      refresh();
    }),
  );
  planButton.addEventListener("click", () => {
    planOnly = !planOnly;
    saveFilters();
    refresh();
  });
  document.addEventListener("plan-change", () => refresh());
  // The list and status don't wait for the map, which can be slow or blocked.
  refresh();
</script>

<style>
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  h1 {
    margin: 0;
    font-size: var(--text-2xl);
  }
  .chips {
    display: flex;
    gap: var(--space-2);
    margin: var(--space-3) calc(var(--space-4) * -1) 0;
    padding: 0 var(--space-4);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .chip[aria-pressed="true"] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }
  .map {
    margin-top: var(--space-3);
  }
  .city-map {
    height: min(55vh, 600px);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .status {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
  }
  .unpinned h2 {
    margin: var(--space-6) 0 var(--space-1);
    font-size: var(--text-lg);
  }
  .unpinned > p {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
  }
  .unpinned ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>

<style is:global>
  /* Event rows in the venue sheet and the "Not on the map" list. */
  .venue-sheet h2 {
    margin: 0;
    font-size: var(--text-xl);
  }
  .venue-sheet > p {
    margin: var(--space-1) 0 var(--space-3);
    font-size: var(--text-sm);
  }
  .venue-sheet .button {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .venue-sheet .sessions,
  .unpinned ul {
    display: flex;
    flex-direction: column;
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .venue-sheet .sessions li,
  .unpinned li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
  }
  .venue-sheet .sessions p,
  .unpinned li p {
    margin: 0;
    font-size: var(--text-sm);
  }
  .venue-sheet .sessions a,
  .unpinned li a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .venue-sheet .star,
  .unpinned .star {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .venue-sheet .star[aria-pressed="true"],
  .unpinned .star[aria-pressed="true"] {
    color: var(--accent);
  }
  .venue-sheet .star[aria-pressed="true"] svg,
  .unpinned .star[aria-pressed="true"] svg {
    fill: currentColor;
  }
</style>
