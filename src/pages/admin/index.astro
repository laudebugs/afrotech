---
// The admin dashboard (plan 0011): how people use the planner, as totals.
// The page holds no numbers; it asks the Worker, which answers only accounts
// in the ADMIN_EMAILS secret. Not linked from anywhere, and not indexed.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allEvents } from "../../lib/events";

// Session titles for the "top" lists, which name events by id.
const titles = Object.fromEntries(allEvents.map((e) => [e.id, e.title]));
---

<BaseLayout title="Dashboard · AfroTech 2026 Planner" active="none" noindex description="Usage totals for the planner's admin.">
  <div class="admin">
    <header class="head">
      <h1>Dashboard</h1>
      <div class="refresh" data-loaded hidden>
        <span class="muted" data-updated></span>
        <button type="button" class="button" data-refresh>Refresh</button>
      </div>
    </header>

    <p class="state" data-state>Loading…</p>

    <div data-dashboard hidden>
      <section aria-labelledby="traffic-title">
        <h2 id="traffic-title">Visitors</h2>
        <p class="muted small">Page views from Cloudflare's logs. Nothing on the site tracks visitors.</p>
        <div data-traffic></div>
      </section>

      <section aria-labelledby="accounts-title">
        <h2 id="accounts-title">Accounts</h2>
        <div data-accounts></div>
      </section>

      <section aria-labelledby="plan-title">
        <h2 id="plan-title">My plan</h2>
        <div data-plan></div>
      </section>

      <section aria-labelledby="notes-title">
        <h2 id="notes-title">Notes and photos</h2>
        <div data-notes></div>
      </section>

      <p class="muted small" data-privacy></p>
    </div>
  </div>
  <script type="application/json" id="event-titles" set:html={JSON.stringify(titles).replace(/</g, "\\u003c")} />
</BaseLayout>

<script>
  import { api } from "../../scripts/api";
  import { SIGNED_IN, getItem } from "../../lib/storage";
  import { chartRange, fillDays, formatBytes, shortDay, type DayCount } from "../../lib/admin";
  import { dayNoon, formatDate, formatTime } from "../../lib/time";

  const fullDay = (day: string) => formatDate(dayNoon(day));

  type Metrics = {
    at: number;
    accounts: { total: number; signedIn: number; newPerDay: DayCount[]; activePerDay: DayCount[] };
    plan: { accounts: number; stars: number; perDay: DayCount[]; top: { id: string; n: number }[] };
    notes: { accounts: number; notes: number; perDay: DayCount[]; top: { id: string; n: number }[] };
    photos: { count: number; bytes: number };
    minGroup: number;
  };
  type Ranked = { name: string; n: number };
  type Traffic =
    | { configured: false }
    | { configured: true; error: string }
    | {
        configured: true;
        error?: undefined;
        from: string;
        to: string;
        days: { day: string; views: number; visits: number }[];
        pages: Ranked[];
        countries: Ranked[];
        devices: Ranked[];
        missing: number;
      };

  const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const titles: Record<string, string> = JSON.parse($("#event-titles").textContent || "{}");
  const num = new Intl.NumberFormat("en-US");

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, attrs: Record<string, string> = {}, ...kids: (Node | string)[]) {
    const node = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
    node.append(...kids);
    return node;
  }

  /** A row of headline numbers. */
  function tiles(items: [string, string | number][]): HTMLElement {
    return el(
      "dl",
      { class: "tiles" },
      ...items.map(([label, value]) =>
        el("div", { class: "tile" }, el("dt", {}, label), el("dd", {}, typeof value === "number" ? num.format(value) : value)),
      ),
    );
  }

  const SVG = "http://www.w3.org/2000/svg";
  function svg<K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string | number>) {
    const node = document.createElementNS(SVG, tag);
    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
    return node;
  }

  /**
   * Bars per day, one series. Bars have rounded tops on a shared baseline and
   * a 2 px gap; the biggest day and today carry their value. Hovering or
   * focusing a bar shows its day and value; a table holds every number.
   */
  function dayChart(title: string, unit: string, days: DayCount[]): HTMLElement {
    const W = 100 * days.length;
    const H = 120;
    const TOP = 18; // room for value labels
    const max = Math.max(1, ...days.map((d) => d.n));
    const chart = svg("svg", { viewBox: `0 0 ${W} ${H + 22}`, class: "bars", role: "img", "aria-label": title });
    const best = days.reduce((b, d, i) => (d.n > days[b]!.n ? i : b), 0);
    days.forEach((d, i) => {
      const slot = 100;
      const bw = slot - 8; // a visible gap between bars at any width
      const x = i * slot + 4;
      const h = d.n === 0 ? 0 : Math.max(3, ((H - TOP) * d.n) / max);
      const y = H - h;
      const r = Math.min(4, bw / 2, h);
      const g = svg("g", { class: "bar", tabindex: 0, "aria-label": `${fullDay(d.day)}: ${num.format(d.n)} ${unit}` });
      // A hit area as tall as the chart, so thin bars are easy to hover.
      g.append(svg("rect", { x: i * slot, y: 0, width: slot, height: H, class: "hit" }));
      if (h > 0) {
        g.append(
          svg("path", {
            d: `M${x},${H} V${y + r} Q${x},${y} ${x + r},${y} H${x + bw - r} Q${x + bw},${y} ${x + bw},${y + r} V${H} Z`,
            class: "mark",
          }),
        );
      }
      const tip = svg("title", {});
      tip.textContent = `${fullDay(d.day)}: ${num.format(d.n)} ${unit}`;
      g.append(tip);
      if ((i === best || i === days.length - 1) && d.n > 0) {
        const label = svg("text", { x: i * slot + slot / 2, y: y - 6, class: "value" });
        label.textContent = num.format(d.n);
        g.append(label);
      }
      // The axis uses "Wed 4" to fit; the tooltip and table give the full date.
      const day = svg("text", { x: i * slot + slot / 2, y: H + 17, class: "day", "aria-hidden": "true" });
      day.textContent = shortDay(d.day);
      g.append(day);
      chart.append(g);
    });
    chart.append(svg("line", { x1: 0, x2: W, y1: H, y2: H, class: "base" }));

    const table = el(
      "table",
      {},
      el("thead", {}, el("tr", {}, el("th", { scope: "col" }, "Day"), el("th", { scope: "col" }, unit[0]!.toUpperCase() + unit.slice(1)))),
      el("tbody", {}, ...days.map((d) => el("tr", {}, el("td", {}, fullDay(d.day)), el("td", {}, num.format(d.n))))),
    );
    return el(
      "figure",
      { class: "chart" },
      el("figcaption", {}, title),
      chart,
      el("details", {}, el("summary", {}, "Table"), table),
    );
  }

  /** A ranked list with a bar behind each count, scaled to the first. */
  function ranked(title: string, rows: Ranked[], empty: string): HTMLElement {
    const max = Math.max(1, ...rows.map((r) => r.n));
    const list = rows.length
      ? el(
          "ol",
          { class: "ranked" },
          ...rows.map((r) => {
            const li = el("li", {}, el("span", { class: "name" }, r.name), el("span", { class: "count" }, num.format(r.n)));
            li.style.setProperty("--share", String(r.n / max));
            return li;
          }),
        )
      : el("p", { class: "muted small" }, empty);
    return el("div", { class: "rank-block" }, el("h3", {}, title), list);
  }

  const titled = (rows: { id: string; n: number }[]) => rows.map((r) => ({ name: titles[r.id] ?? r.id, n: r.n }));

  function renderMetrics(m: Metrics) {
    const now = m.at;
    const range = chartRange([m.accounts.newPerDay, m.accounts.activePerDay, m.plan.perDay, m.notes.perDay], now);
    const days = (s: DayCount[]) => fillDays(s, range.from, range.to);

    $("[data-accounts]").replaceChildren(
      tiles([
        ["Accounts", m.accounts.total],
        ["Signed in, last 30 days", m.accounts.signedIn],
      ]),
      el(
        "div",
        { class: "charts" },
        dayChart("Accounts by the day of their latest star or note", "accounts", days(m.accounts.activePerDay)),
        dayChart("New accounts per day", "new accounts", days(m.accounts.newPerDay)),
      ),
    );
    $("[data-plan]").replaceChildren(
      tiles([
        ["Accounts with stars", m.plan.accounts],
        ["Stars", m.plan.stars],
      ]),
      el("div", { class: "charts" }, dayChart("Stars by the day they were saved", "stars", days(m.plan.perDay))),
      ranked("Most-starred sessions", titled(m.plan.top), `No session has stars from ${m.minGroup} accounts yet.`),
    );
    $("[data-notes]").replaceChildren(
      tiles([
        ["Accounts with notes", m.notes.accounts],
        ["Notes", m.notes.notes],
        ["Photos", m.photos.count],
        ["Photo storage", formatBytes(m.photos.bytes)],
      ]),
      el("div", { class: "charts" }, dayChart("Notes started per day", "notes", days(m.notes.perDay))),
      ranked("Sessions with the most note-takers", titled(m.notes.top), `No session has notes from ${m.minGroup} accounts yet.`),
    );
    $("[data-privacy]").textContent =
      `Totals only: no names, emails or note text. Lists show a session only once ${m.minGroup} or more accounts share it. Days are in Houston time, by each device's clock.`;
  }

  function renderTraffic(t: Traffic | null) {
    const box = $("[data-traffic]");
    if (!t) {
      box.replaceChildren(el("p", { class: "muted" }, "Traffic couldn't load. Try Refresh."));
    } else if (!t.configured) {
      box.replaceChildren(
        el(
          "p",
          { class: "muted" },
          "Not set up yet: add a Cloudflare API token that can read this zone's analytics as the secret CF_ANALYTICS_TOKEN.",
        ),
      );
    } else if (t.error !== undefined) {
      box.replaceChildren(el("p", { class: "muted" }, `Cloudflare's analytics answered: ${t.error}`));
    } else {
      // Every day in the range gets a bar, so a day that failed to load shows as a gap.
      const views = fillDays(t.days.map((d) => ({ day: d.day, n: d.views })), t.from, t.to);
      const visits = fillDays(t.days.map((d) => ({ day: d.day, n: d.visits })), t.from, t.to);
      const sum = (s: DayCount[]) => s.reduce((a, d) => a + d.n, 0);
      const today = t.days.find((d) => d.day === t.to);
      box.replaceChildren(
        tiles([
          [`Page views, ${views.length} days`, sum(views)],
          ["Visits", sum(visits)],
          ["Today's views", today ? today.views : "–"],
        ]),
        el(
          "div",
          { class: "charts" },
          dayChart("Page views per day", "page views", views),
          dayChart("Visits per day", "visits", visits),
        ),
        el(
          "div",
          { class: "ranks" },
          ranked("Top pages", t.pages, "No page views yet."),
          ranked("Countries", t.countries, "No page views yet."),
          ranked("Devices", t.devices, "No page views yet."),
        ),
        ...(t.missing ? [el("p", { class: "muted small" }, `${t.missing === 1 ? "One day" : `${t.missing} days`} couldn't load from Cloudflare, which keeps only recent days, and ${t.missing === 1 ? "shows" : "show"} as empty.`)] : []),
      );
    }
  }

  const state = $("[data-state]");
  function show(message: string | null) {
    state.textContent = message ?? "";
    state.hidden = message === null;
    $("[data-dashboard]").hidden = message !== null;
  }

  let loading = false;
  async function load() {
    // Signed-out visitors send no requests at all.
    if (!getItem(SIGNED_IN)) {
      show("");
      state.replaceChildren("Sign in on the ", el("a", { href: "/plan/" }, "Saved"), " tab to see the dashboard.");
      return;
    }
    if (loading) return;
    loading = true;
    try {
      const [metrics, traffic] = await Promise.all([
        api("GET", "/api/admin/metrics"),
        api("GET", "/api/admin/traffic").catch(() => null),
      ]);
      if (metrics.status === 404 || metrics.status === 401) return show("This page isn't available for your account.");
      if (!metrics.ok) return show("The numbers couldn't load. Try again in a moment.");
      const m = (await metrics.json()) as Metrics;
      renderMetrics(m);
      renderTraffic(traffic ? ((await traffic.json().catch(() => null)) as Traffic | null) : null);
      show(null);
      $("[data-updated]").textContent = `Updated ${formatTime(new Date(m.at))}`;
      $("[data-loaded]").hidden = false;
    } catch {
      show("You're offline, or the server didn't answer. Try again in a moment.");
    } finally {
      loading = false;
    }
  }

  $("[data-refresh]").addEventListener("click", () => void load());
  void load();
</script>

<style>
  .admin {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-4) var(--space-8);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }
  h1 {
    margin: 0;
  }
  h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }
  h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-md);
  }
  section {
    display: grid;
    gap: var(--space-4);
    padding-block-start: var(--space-4);
    border-top: 1px solid var(--line);
  }
  section > * {
    margin: 0;
  }
  [data-dashboard]:not([hidden]),
  [data-traffic],
  [data-accounts],
  [data-plan],
  [data-notes] {
    display: grid;
    gap: var(--space-4);
  }
  [data-dashboard]:not([hidden]) {
    gap: var(--space-6);
  }
  .refresh {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .refresh[hidden] {
    display: none;
  }
  .small {
    font-size: var(--text-sm);
  }
  .button {
    min-height: var(--tap);
    padding: 0 var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  /* Headline numbers. */
  :global(.admin .tiles) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-3);
    margin: 0;
  }
  :global(.admin .tile) {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  :global(.admin .tile dt) {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  :global(.admin .tile dd) {
    margin: var(--space-1) 0 0;
    font-size: var(--text-2xl);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* Day charts. */
  :global(.admin .charts),
  :global(.admin .ranks) {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 720px) {
    :global(.admin .charts) {
      grid-template-columns: 1fr 1fr;
    }
    :global(.admin .ranks) {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
  :global(.admin .chart) {
    margin: 0;
    min-width: 0;
  }
  :global(.admin .chart figcaption) {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  :global(.admin .bars) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  :global(.admin .bars .mark) {
    fill: var(--accent);
  }
  :global(.admin .bars .hit) {
    fill: transparent;
  }
  :global(.admin .bars .bar:hover .mark),
  :global(.admin .bars .bar:focus-visible .mark) {
    opacity: 0.8;
  }
  :global(.admin .bars .bar:focus-visible) {
    outline: none;
  }
  :global(.admin .bars .bar:focus-visible .hit) {
    stroke: var(--accent);
    stroke-width: 3;
  }
  :global(.admin .bars .base) {
    stroke: var(--line);
    stroke-width: 2;
  }
  :global(.admin .bars text) {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 22px;
    text-anchor: middle;
  }
  :global(.admin .bars .value) {
    fill: var(--ink);
    font-weight: 500;
  }
  :global(.admin .chart details) {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
  }
  :global(.admin .chart summary) {
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
    color: var(--muted);
    cursor: pointer;
  }
  :global(.admin table) {
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  :global(.admin th),
  :global(.admin td) {
    padding: var(--space-1) var(--space-4) var(--space-1) 0;
    text-align: left;
  }

  /* Ranked lists: the bar behind each row is its share of the top row. */
  :global(.admin .rank-block) {
    min-width: 0;
  }
  :global(.admin .ranked) {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.admin .ranked li) {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    border-radius: var(--radius-sm);
    isolation: isolate;
  }
  :global(.admin .ranked li::before) {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--share) * 100%);
    border-radius: inherit;
    background: var(--glass-capsule);
    z-index: -1;
  }
  :global(.admin .ranked .name) {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  :global(.admin .ranked .count) {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
</style>
